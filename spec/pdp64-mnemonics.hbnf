; pdp64 mnemonics.  Each rule is an enum: the literal's number IS its encoding (opcode, or sub-opcode within the group).
; Mnemonics are lowercase, as in V7 as (hbnf does not take numbered enum values under a case-insensitive rule: to report upstream).
; Numbers are binary, the width of the field they are encoded in (needs the hbnf patch in tools/hbnf-numbers.patch until upstream has it).  `docs/errata.md` says where the ISA left a number open.
; Groups that share a mnemonic between load and store directions (MOVQ...) are numbered by the load opcode; the store is +1.

; moves between a register and an operand: load = n, store = n+1 (ISA 4.1)
mn-mov = "movq"@0b000000
       | "movl"@0b000010
       | "movw"@0b000100
       | "movb"@0b000110

; zero-extending loads
mn-movz = "movzl"@0b001000
        | "movzw"@0b001001
        | "movzb"@0b001010

; effective address
mn-lea = "lea"@0b001011

; ALU and FP ALU: register destination (ISA 4.2, 4.10); CMP computes reg - rm, errata 13
mn-alu = "add"@0b010110
       | "sub"@0b010111
       | "bic"@0b011000
       | "bis"@0b011001
       | "cmp"@0b011010
       | "bit"@0b011011
       | "xor"@0b011100
       | "and"@0b011101
       | "mul"@0b011110
       | "mulh"@0b011111
       | "shl"@0b100000
       | "shr"@0b100001
       | "sar"@0b100010
       | "faddd"@0b100100
       | "fsubd"@0b100101
       | "fmuld"@0b100110
       | "fcmpd"@0b100111
       | "mulu"@64

; conditional branches (ISA 4.4); BHIS and BLO are aliases below
mn-branch = "br"@0b110000
          | "bne"@0b110001
          | "beq"@0b110010
          | "bpl"@0b110011
          | "bmi"@0b110100
          | "bvc"@0b110101
          | "bvs"@0b110110
          | "bcc"@0b110111
          | "bcs"@0b111000
          | "bge"@0b111001
          | "blt"@0b111010
          | "bgt"@0b111011
          | "ble"@0b111100
          | "bhi"@0b111101
          | "blos"@0b111110
          | "bhis"@64
          | "blo"@65

; subtract one and branch
mn-sob = "sob"@0b111111

; tag branches (ISA 4.8): the sense bit
mn-tag = "btag"@0b0
       | "bntag"@0b1

; SOP: the reg field is the sub-opcode
mn-sop = "clr"@0b0000
       | "com"@0b0001
       | "inc"@0b0010
       | "dec"@0b0011
       | "neg"@0b0100
       | "tst"@0b0101
       | "adc"@0b0110
       | "sbc"@0b0111
       | "asl"@0b1000
       | "asr"@0b1001
       | "pushm"@0b1010
       | "popm"@0b1011
       | "jmp"@0b1100
       | "call"@0b1101
       | "push"@0b1110
       | "pop"@0b1111

; XFER: the reg field is the sub-opcode
mn-xfer = "jmpi"@0b0000
        | "calli"@0b0001
        | "jtag"@0b0010

; BESC: sub-opcode in parcel 1
mn-besc = "clz"@0b00000000
        | "ctz"@0b00000001
        | "clo"@0b00000010
        | "cto"@0b00000011
        | "popcnt"@0b00000100
        | "bswap"@0b00000101
        | "bswapw"@0b00000110
        | "bswapl"@0b00000111
        | "bitrev"@0b00001000
        | "ror"@0b00010000
        | "rori"@0b00010001
        | "dshr"@0b00100000
        | "extb"@0b00100001
        | "extzb"@0b00100010
        | "insb"@0b00100011
        | "xnorpop"@0b00110000
        | "clmull"@0b00110001
        | "clmulh"@0b00110010
        | "crc32b"@0b00110100
        | "crc32w"@0b00110101
        | "crc32l"@0b00110110
        | "crc32q"@0b00110111
        | "crc32cb"@0b00111000
        | "crc32cw"@0b00111001
        | "crc32cl"@0b00111010
        | "crc32cq"@0b00111011
        | "utf8len"@0b01000000
        | "utf8dec"@0b01000001
        | "utf8enc"@0b01000010
        | "rol"@256

; MBLK: sub-opcode in parcel 1
mn-mblk = "mcpy"@0b00000000
        | "mmov"@0b00000001
        | "mset"@0b00000010
        | "mcmp"@0b00000011
        | "mscn"@0b00000100
        | "mscnn"@0b00000101
        | "mval"@0b00000110

; AESC: sub-opcode in parcel 1
mn-aesc = "div"@0b00000000
        | "divu"@0b00000001
        | "mod"@0b00000010
        | "modu"@0b00000011
        | "mulhu"@0b00000100

; FESC: sub-opcode in parcel 1
mn-fesc = "fdivd"@0b00000000
        | "fsqrtd"@0b00000001
        | "fadds"@0b00001000
        | "fsubs"@0b00001001
        | "fmuls"@0b00001010
        | "fdivs"@0b00001011
        | "fsqrts"@0b00001100
        | "fcmps"@0b00001101
        | "fmaddd"@0b00010000
        | "fmsubd"@0b00010001
        | "fnmaddd"@0b00010010
        | "fnmsubd"@0b00010011
        | "fmadds"@0b00011000
        | "fmsubs"@0b00011001
        | "fnmadds"@0b00011010
        | "fnmsubs"@0b00011011
        | "fneg"@0b00100000
        | "fabs"@0b00100001
        | "fcopysign"@0b00100010
        | "fmind"@0b00100011
        | "fmaxd"@0b00100100
        | "fclassd"@0b00101000
        | "fclasss"@0b00101001
        | "frintd"@0b00110000
        | "frintdz"@0b00110001
        | "frintdm"@0b00110010
        | "frintdp"@0b00110011
        | "frintda"@0b00110100
        | "fcvtdq"@0b00111000
        | "fcvtqd"@0b00111001
        | "fcvtds"@0b00111010
        | "fcvtsd"@0b00111011
        | "fcvtsl"@0b00111100
        | "fcvtls"@0b00111101
        | "fcvtdqu"@0b00111110
        | "fcvtqud"@0b00111111
        | "fsflags"@0b01000000

; ATOM: sub-opcode in parcel 1
mn-atom = "cas"@0b00000000
        | "casdb"@0b00000001
        | "swap"@0b00000010
        | "swapdb"@0b00000011
        | "xadd"@0b00000100
        | "xadddb"@0b00000101
        | "xand"@0b00000110
        | "xanddb"@0b00000111
        | "xor_"@0b00001000
        | "xor_db"@0b00001001
        | "xxor"@0b00001010
        | "xxordb"@0b00001011
        | "xmax"@0b00001100
        | "xmaxdb"@0b00001101
        | "xmin"@0b00001110
        | "xmindb"@0b00001111
        | "xmaxu"@0b00010000
        | "xmaxudb"@0b00010001
        | "xminu"@0b00010010
        | "xminudb"@0b00010011
        | "ll"@0b00100000
        | "sc"@0b00100001

; MESC: sub-opcode in parcel 1 (4 bits); the MOVU* names appear twice in the table, ld = n and st = n+1: numbered by the load
; MESC
mn-mesc = "movub"@0b0000
        | "movuw"@0b0010
        | "movul"@0b0100
        | "movuq"@0b0110
        | "addm"@0b1000
        | "subm"@0b1001
        | "bicm"@0b1010
        | "bism"@0b1011

; SYS class 0: no operand, the number is the minor opcode in the rm field
mn-sys-none = "nop"@0b0000
            | "rti"@0b0001
            | "rtt"@0b0010
            | "ret"@0b0011
            | "halt"@0b0100
            | "bpt"@0b0101
            | "fence"@0b0110
            | "wfe"@0b0111
            | "sev"@0b1000
            | "lpad"@0b1001
            | "tlbia"@0b1010
            | "tlbsync"@0b1011
            | "icinva"@0b1100
            | "wait"@16

; SYS classes with an operand: the number is the class in the reg field
mn-sys = "mtps"@0b0001
       | "mfps"@0b0010
       | "spl"@0b0011
       | "trap"@0b0100
       | "tlbi"@0b0101
       | "mtasid"@0b0110
       | "mfasid"@0b0111
       | "mtdp"@0b1000
       | "mfdp"@0b1001
       | "mtdmw"@0b1010
       | "mfcpuid"@0b1011
       | "icinv"@0b1100
       | "prober"@0b1101
       | "probew"@0b1110
       | "trapl"@0b1111

; (the assembler aliases of ISA 4.15 are in the groups they stand for, numbered above the encodings of the group: bhis, blo, mulu, wait, rol)


; Opcodes of the groups whose own mnemonics name sub-operations (SOP, SYS, BESC...), and of LEA and SOB, which have a single mnemonic.
opgroup = "lea"@0b001011
        | "besc"@0b001100
        | "mblk"@0b001101
        | "aesc"@0b001110
        | "mesc"@0b001111
        | "fesc"@0b010000
        | "atom"@0b010001
        | "xfer"@0b010010
        | "sop"@0b010011
        | "sys"@0b010100
        | "tag"@0b010101
        | "sob"@0b111111

; The addressing modes, the `low` nibble of an instruction with a memory operand (ISA section 5).
amode = "base"@0b0000
      | "index"@0b0001
      | "pcrel"@0b0010
      | "dp"@0b0011
      | "imm"@0b0100
      | "abs"@0b0101
      | "postinc"@0b0110
      | "predec"@0b0111

; The store forms of the moves: the same mnemonics, the opcode after the load's (ISA section 4.1).
movstore = "movq"@0b000001 | "movl"@0b000011 | "movw"@0b000101 | "movb"@0b000111

; The registers (ISA section 2.1): R0-R15; SP is R14 and FP is R13 (the stack and frame pointers are ordinary registers named by convention);
; PC and DP appear only as the base of an operand (modes `pcrel` and `dp`).
rnum = "r0"@0 | "r1"@1 | "r2"@2 | "r3"@3 | "r4"@4 | "r5"@5 | "r6"@6 | "r7"@7
     | "r8"@8 | "r9"@9 | "r10"@10 | "r11"@11 | "r12"@12 | "r13"@13 | "r14"@14 | "r15"@15
ralias = "sp"@14 | "fp"@13
basespec = "pc"@1 | "dp"@2
