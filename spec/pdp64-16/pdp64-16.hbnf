      | "CBI8_12/a"@113 | "IMM3/a"@114 | "CBI3_10/c"@115 | "LDI12/c"@116 | "LDX2/b"@117 | "CBI5_10/b"@118 | "LDPC16/a"@119 | "LDBu10/a"@120
      | "SPADJ6/a"@121 | "LDHHH1/a"@122 | "CBI10_8/c"@123 | "STHHH1/a"@124 | "LDI14/b"@125 | "STBu10/a"@126 | "BR1_6/b"@127 | "LEASP4/a"@128
      | "CBR10/b"@129 | "CBI12_8/a"@130 | "BR1_8/a"@131 | "PUSHM8/a"@132 | "CBI5_10/c"@133 | "LDSP4/a"@134 | "STSP4/a"@135 | "CBI3_14/a"@136
      | "CBZ2_14/b"@137 | "STBs8/b"@138 | "CBZ1_5/a"@139 | "CALL2_20/c"@140 | "CBI10_8/b"@141 | "SHI3/a"@142 | "LDBs12/a"@143 | "IMM5/a"@144
      | "CBR14/a"@145 | "STBu10/b"@146 | "CMBu10/a"@147 | "LDHHH3/a"@148 | "LDX2/c"@149 | "CBI12_8/c"@150 | "CBI16_8/a"@151 | "IMM3/b"@152
