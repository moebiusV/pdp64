; pdp64/16: the grammar of the encoding -- 16 registers (r0-r15), 219 forms, 281 leaves.
;
; Written by docs/codegen-data/encoding/write_hbnf.py and edited by hand from then on (the vocabulary is in pdp64-enc.hbnf, the workflow in spec/README.md).
; Everything the codec, the assembler, the linker, the simulator and the documentation know of this encoding is generated from this file.

prefix none
include "../pdp64-enc.hbnf"

encoding-name = "pdp64/16"

; The instruction: one leaf.  An instruction that no leaf matches is illegal (3277 of the 65,536 first parcels).
insn = leaf-SYS0-1 | leaf-SYS0-2 | leaf-SYSR-1 | leaf-SYSR-2 | leaf-SETF-1 | leaf-SYSI-1 | leaf-MFSR-1 | leaf-MTSR-1 | leaf-R2-1 | leaf-R3-1
