     | leaf-IMM4-b-1 | leaf-IMM4-b-2 | leaf-CBZ1-6-a-1 | leaf-STSP5-a-1 | leaf-BR1-6-c-1 | leaf-BR1-6-c-2 | leaf-LEASP6-a-1 | leaf-CBR12-b-1
     | leaf-CBI8-10-b-1 | leaf-CMPC16-a-1 | leaf-SOX6-a-1 | leaf-SOX6-a-2 | leaf-LDPC12-b-1 | leaf-CMX2-a-1 | leaf-LDI18-a-1 | leaf-CBI8-10-c-1
     | leaf-ST0-a-1 | leaf-CMPI3-a-1 | leaf-LDBs8-b-1 | leaf-CBI6-12-b-1 | leaf-LDX4-b-1 | leaf-CMS12-a-1 | leaf-LDPC12-d-1 | leaf-LDPC12-d-2
     | leaf-LDPC14-b-1 | leaf-BR1-8-b-1 | leaf-CBI4-12-c-1 | leaf-STSP4-b-1 | leaf-CMBu12-a-1 | leaf-SPADJ8-a-1 | leaf-STBs10-a-1 | leaf-IMM3-c-1
     | leaf-LDI14-c-1 | leaf-LDBu12-a-1 | leaf-SOBs12-a-1 | leaf-SOBs12-a-2 | leaf-LDBs8-d-1 | leaf-LDBs8-d-2 | leaf-STBs10-b-1 | leaf-SOX6-x-1
     | leaf-LDI16-c-1 | leaf-CMBs10-a-1 | leaf-LEAS14-a-1

; ---- the registers
regs = "r0"@0 | "r1"@1 | "r2"@2 | "r3"@3 | "r4"@4 | "r5"@5 | "r6"@6 | "r7"@7 | "r8"@8 | "r9"@9 | "r10"@10 | "r11"@11 | "r12"@12 | "r13"@13 | "r14"@14
     | "r15"@15
; A register field of W bits that cannot hold a register number is an index into the table hotW (the part of the ABI the encoding depends on, docs/abi.md).
hot3 = "r0" | "r1" | "r8" | "r2" | "sp" | "r3" | "r9" | "r10"

; ---- the fused instructions (the assembler never fuses: they are ordinary mnemonics with operands, chosen by the compiler)
fused = "movcall" | "popmret" | "popret" | "mov2"

; ---- the catalogue of forms: the number is the index of the form (the assembler tries the forms of a mnemonic, shorter first, in this order)
forms = "SYS0"@0 | "SYSR"@1 | "SETF"@2 | "SYSI"@3 | "MFSR"@4 | "MTSR"@5 | "R2"@6 | "R3"@7 | "R4"@8 | "RRI"@9 | "BFx"@10 | "BFy"@11 | "MOVQL"@12
      | "LDU.B28"@13 | "STU.B28"@14 | "LDU.B12"@15 | "STU.B12"@16 | "LDU.X6"@17 | "STU.X6"@18 | "LDF.B28"@19 | "LDF.X22"@20 | "LDF.PI12"@21
      | "LDF.PD12"@22 | "LDF.PC32"@23 | "LDF.A32"@24 | "LDFI.I32"@25 | "STF.B28"@26 | "STF.X22"@27 | "STF.PI12"@28 | "STF.PD12"@29 | "STF.PC32"@30
      | "STF.A32"@31 | "CMF.B28"@32 | "CMF.X22"@33 | "CMF.PI12"@34 | "CMF.PD12"@35 | "CMF.PC32"@36 | "CMF.A32"@37 | "CMF.I32"@38 | "SOF.B28"@39
      | "SOF.X22"@40 | "SOF.PI12"@41 | "SOF.PD12"@42 | "SOF.PC32"@43 | "SOF.A32"@44 | "DPF.D28"@45 | "BRF"@46 | "CALLF"@47 | "PUSHMF"@48 | "SOPR"@49
