      | "CMI12/a"@96 | "CALL2_16/j"@97 | "LDBs8/a"@98 | "LDBu8/c"@99 | "CBR10/c"@100 | "LDPC14/a"@101 | "LDI14/a"@102 | "STX2/b"@103 | "SOBu12/a"@104
