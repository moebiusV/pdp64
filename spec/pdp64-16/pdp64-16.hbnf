      | "FX.MOVCALL2"@61 | "FX.POPMRET"@62 | "FX.POPRET"@63 | "FX.MOV2"@64 | "CBI4_8/a"@65 | "CBR8/a"@66 | "CBI5_8/b"@67 | "CBZ2_12/a"@68
      | "CBR8/c"@69 | "BR2_16/a"@70 | "LDI12/a"@71 | "LDBu8/a"@72 | "CBI5_8/a"@73 | "CALL2_16/c"@74 | "STBs8/a"@75 | "CBI8_8/b"@76 | "CBR8/b"@77
      | "CBI10_8/a"@78 | "LDX2/a"@79 | "PUSHM16a/a"@80 | "LDI12/b"@81 | "CBI4_8/c"@82 | "CBI4_10/a"@83 | "BR2_16/b"@84 | "STBu8/b"@85 | "CBZ2_12/b"@86
