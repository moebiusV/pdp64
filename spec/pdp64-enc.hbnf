       | "movw.ud"@42 | "movzb.d"@43 | "movzb.u"@44 | "movzb.ud"@45 | "movzl.d"@46 | "movzl.u"@47 | "movzl.ud"@48 | "movzw.d"@49 | "movzw.u"@50
       | "movzw.ud"@51 | "msha256"@52 | "msha512"@53 | "mulv"@54 | "popmret"@55 | "popret"@56 | "sha256sig0"@57 | "sha256sig1"@58 | "sha256sum0"@59
