; pdp64 assembly language.  One statement to a line; `;` starts a comment; `name:` defines a label, and the numeric labels
; `1:` are referenced as `1b` (back) and `1f` (forward); `sym = expr` assigns.  Numbers, characters and strings are C's:
; decimal by default, `0x`, `0b` and `0o` when asked for; `'a'`; `"text\n"`.  Operators are C's (`/` is division).  The
; operand modes are those of ISA section 5.  See docs/asm-syntax.md.
language C
prefix none
statements
whitespace ws
include "common.hbnf"
include "pdp64-mnemonics.hbnf"

asm = | asm line


ws = SP | HTAB | comment
comment = ";" *( %x01-09 | %x0B-D7FF | %xE000-10FFFF )
line = *label [ stmt ]

label = symbol ":"
stmt = assign | directive | instruction

assign = symbol "=" expr
directive = "." dname [ dargs ]
dname = "text" | "data" | "bss" | "globl" | "comm" | "byte" | "word" | "long" | "quad"
      | "even" | "align" | "space" | "ascii" | "lpad"
dargs = darg *( "," darg )
darg = string | expr

instruction = mnemonic [ operand *( "," operand ) ]
; `mnemonic` (the groups of pdp64-mnemonics.hbnf, in an order that keeps a word from being taken for the front of a longer one) is written by tools/mkgrammar.py

; --- operands (ISA section 5) -----------------------------------------------------------------------------------
operand = immop | absop | postinc | predec | predec2 | indexed | based | regop | bare
immop   = "#" expr
absop   = "@" expr
regop   = reg
postinc = "(" reg ")" "+" [ expr ]
predec  = "-" "(" reg ")"
predec2 = "(" reg ")" "-" expr
; with a displacement, or without: `(r1)` would otherwise be taken for the parenthesized expression r1
indexed = expr "(" reg ")" "(" reg [ "*" scale ] ")" | "(" reg ")" "(" reg [ "*" scale ] ")"
based   = expr "(" basereg ")" | "(" basereg ")"
bare    = expr

; R0..R15; SP is R14 and FP is R13 (ISA 2.1); PC and DP only as a base register
reg      = rnum | ralias
rnum     = "r0"@0 | "r1"@1 | "r2"@2 | "r3"@3 | "r4"@4 | "r5"@5 | "r6"@6 | "r7"@7
         | "r8"@8 | "r9"@9 | "r10"@10 | "r11"@11 | "r12"@12 | "r13"@13 | "r14"@14 | "r15"@15
ralias   = "sp" | "fp"
basereg  = reg | basespec
basespec = "pc" | "dp"
scale    = "1" | "2" | "4" | "8"

; --- expressions ----------------------------------------------------------------------------------------------------
expr    = term *( addop term )
addop   = "+" | "-" | "|" | "^"
term    = unary *( mulop unary )
mulop   = "*" | "/" | "%" | "&" | "<<" | ">>"
unary   = *( "-" | "~" | "!" ) primary
; a number is a whole bareword: 3dfx is a name, 3 and 0x3d and 1f are not
primary = prefixnum !idchar | localref !idchar | decnum !idchar | charlit | symbol | "." | "(" expr ")"

prefixnum = hexnum | binnum | octnum
hexnum   = "0" ( "x" | "X" ) 1*HEXDIG
binnum   = "0" ( "b" | "B" ) 1*( "0" | "1" )
octnum   = "0" ( "o" | "O" ) 1*( "0" | "1" | "2" | "3" | "4" | "5" | "6" | "7" )
decnum   = 1*DIGIT
charlit  = "'" ( %x20-26 | %x28-5B | %x5D-7E | uni | escape ) "'"
localref = 1*DIGIT ( "f" | "b" )
symbol   = ( idstart | DIGIT ) *idchar | qname
idstart  = ALPHA | "_" | "." | uni
idchar   = idstart | DIGIT | "$"
uni      = %x80-D7FF | %xE000-10FFFF
qname    = %x22 1*( %x20-21 | %x23-D7FF | %xE000-10FFFF ) %x22
string   = %x22 *( %x20-21 | %x23-5B | %x5D-7E | uni | escape ) %x22
escape   = %x5C ( "n" | "t" | "r" | "a" | "b" | "f" | "v" | "0" | %x5C | "'" | %x22 | "x" 1*2HEXDIG | "u" 4HEXDIG | "U" 8HEXDIG | %x30-37 *2( %x30-37 ) )
