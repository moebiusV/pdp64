; pdp64 assembly language.  One statement to a line; `;` starts a comment; `name:` defines a label, and the numeric labels
; `1:` are referenced as `1b` (back) and `1f` (forward); `sym = expr` assigns.  Numbers, characters and strings are C's:
; decimal by default, `0x`, `0b` and `0o` when asked for; `'a'`; `"text\n"`.  Operators are C's (`/` is division).  The
; operand modes are those of ISA section 5.  See docs/asm-syntax.md.
language C
prefix none
whitespace ws
include "common.hbnf"
include "pdp64-mnemonics.hbnf"

asm = line

; a name is a word token; with one in the grammar every literal that begins with two letters or more is a whole word (`bit` is not the front of
; `bitrev`, `ror` not the front of `rori`), in any order, and a name cannot be one of those words.  The one-letter choices below are character
; classes in rules of their own, which keeps them character-level in this mode.
word_start = idstart | DIGIT
wordchars = idchar
keywords-on = word          ; names the word token (this is what turns whole-word keywords on); nothing uses it


ws = SP | HTAB | comment
comment = ";" *( %x01-09 | %x0B-D7FF | %xE000-10FFFF )
line = *label [ stmt ]

label = symbol ":"
stmt = assign | directive | instruction | condinsn

assign = symbol "=" expr
directive = "." dname [ dargs ]
dname = "text" | "data" | "bss" | "globl" | "comm" | "byte" | "word" | "long" | "quad"
      | "even" | "align" | "space" | "ascii" | "lpad"
dargs = darg *( "," darg )
darg = string | expr

instruction = mnemonic [ operand *( "," operand ) ]
; an instruction that takes a condition: the condition is a word of its own, then the operands (`set eq, r1`)
condinsn = mn-cond ccw "," operand *( "," operand )
ccw = cc | ccalias
; `mnemonic` (the groups of pdp64-mnemonics.hbnf, in an order that keeps a word from being taken for the front of a longer one) is written by tools/mkgrammar.py

; --- operands (ISA section 5) -----------------------------------------------------------------------------------
operand = immop | absop | postinc | predec | predec2 | indexed | based | regop | bare
immop   = "#" expr
absop   = "@" expr
regop   = reg
postinc = "(" reg ")" "+" [ expr ]
predec  = "-" "(" reg ")"
predec2 = "(" reg ")" "-" expr
; with a displacement, or without: `(r1)` would otherwise be taken for the parenthesized expression r1
indexed = [ expr ] "(" reg ")" "(" reg [ "*" scale ] ")"
based   = [ expr ] "(" basereg ")"
bare    = expr

; R0..R15; SP is R14 and FP is R13 (ISA 2.1); PC and DP only as a base register
reg      = rnum | ralias
basereg  = reg | basespec
scale    = "1" | "2" | "4" | "8"

; --- expressions ----------------------------------------------------------------------------------------------------
expr    = term *( addop term )
addop   = "+" | "-" | "|" | "^"
term    = unary *( mulop unary )
mulop   = "*" | "/" | "%" | "&" | "<<" | ">>"
unary   = *( "-" | "~" | "!" ) primary
; a number is a whole bareword: 3dfx is a name, 3 and 0x3d and 1f are not
primary = prefixnum !idchar | localref !idchar | decnum !idchar | charlit | symbol | "." | "(" expr ")"

prefixnum = hexnum | binnum | octnum
hexnum   = "0" xch 1*HEXDIG
xch      = %x78 | %x58
binnum   = "0" bch 1*( "0" | "1" )
bch      = %x62 | %x42
octnum   = "0" och 1*( "0" | "1" | "2" | "3" | "4" | "5" | "6" | "7" )
och      = %x6F | %x4F
decnum   = 1*DIGIT
charlit  = %x27 chch %x27
chch     = %x20-26 | %x28-5B | %x5D-7E | uni | escape
localref = 1*DIGIT fbch
fbch     = %x66 | %x62
; a name cannot be `r` followed only by digits: r0..r15 are registers (pdp64-mnemonics.hbnf) and anything else of that shape (r16, r99) is an error,
; not a name.  So a name either starts with something other than `r`, or is `r` followed by digits and then something that is not a digit.
symbol   = ( oidstart | DIGIT ) *idchar | rname | qname
oidstart = %x41-5A | %x61-71 | %x73-7A | %x5F | %x2E | uni
rname    = %x72 *DIGIT nodig *idchar | %x72
nodig    = ALPHA | %x5F | %x2E | %x24 | uni
idstart  = ALPHA | "_" | "." | uni
idchar   = idstart | DIGIT | "$"
uni      = %x80-D7FF | %xE000-10FFFF
qname    = %x22 1*qnch %x22
qnch     = %x20-21 | %x23-D7FF | %xE000-10FFFF
string   = %x22 *strch %x22
strch    = %x20-21 | %x23-5B | %x5D-7E | uni | escape
escape   = esc1 | esc-hex | esc-u4 | esc-u8 | esc-oct
esc1     = %x5C escch
escch    = %x6E | %x74 | %x72 | %x61 | %x62 | %x66 | %x76 | %x30 | %x5C | %x27 | %x22
esc-hex  = %x5C %x78 1*2HEXDIG
esc-u4   = %x5C %x75 4HEXDIG
esc-u8   = %x5C %x55 8HEXDIG
esc-oct  = %x5C OCT *2OCT
OCT      = %x30-37
