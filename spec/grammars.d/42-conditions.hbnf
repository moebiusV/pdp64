; targets: asm spec
; The numbers of the conditions of the compare-and-branch family (cbCC, setCC, ctCC): the number is the handler's argument of the executor's table (spec/facts/core.toml) and the order of the
; words of `mn-cbranch`.  The machine has no condition codes: these are conditions on a comparison of two values.  `al` is "always" (`br`).  hs and lo are the usual other names of cc and cs.
cc = "al"@0 | "ne"@1 | "eq"@2 | "cc"@7 | "cs"@8 | "ge"@9 | "lt"@10 | "gt"@11 | "le"@12 | "hi"@13 | "los"@14
ccalias = "hs"@7 | "lo"@8
