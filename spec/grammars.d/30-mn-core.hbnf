; targets: asm spec
; pdp64 mnemonics.  Each rule is an enum: the literal's number IS its encoding (opcode, or sub-opcode within the group).
; Mnemonics are lowercase, as in V7 as (hbnf does not take numbered enum values under a case-insensitive rule: to report upstream).
; Numbers are binary, the width of the field they are encoded in (needs the hbnf patch in tools/hbnf-numbers.patch until upstream has it).  `docs/errata.md` says where the ISA left a number open.
; Groups that share a mnemonic between load and store directions (MOVQ...) are numbered by the load opcode; the store is +1.

; moves between a register and an operand: load = n, store = n+1 (ISA 4.1)
mn-mov = "movq"@0b000000
       | "movl"@0b000010
       | "movw"@0b000100
       | "movb"@0b000110

; zero-extending loads
mn-movz = "movzl"@0b001000
        | "movzw"@0b001001
        | "movzb"@0b001010

; effective address
mn-lea = "lea"@0b001011

; ALU and FP ALU: register destination (ISA 4.2, 4.10); CMP computes reg - rm, errata 13
mn-alu = "add"@0b010110
       | "sub"@0b010111
       | "bic"@0b011000
       | "bis"@0b011001
       | "cmp"@0b011010
       | "bit"@0b011011
       | "xor"@0b011100
       | "and"@0b011101
       | "mul"@0b011110
       | "mulh"@0b011111
       | "shl"@0b100000
       | "shr"@0b100001
       | "sar"@0b100010
       | "fadd"@0b100100
       | "fsub"@0b100101
       | "fmul"@0b100110
       | "fcmp"@0b100111
       | "mulu"@0x11E
        | "faddd"@0x124
        | "fsubd"@0x125
        | "fmuld"@0x126
        | "fcmpd"@0x127

; conditional branches (ISA 4.4); BHIS and BLO are aliases below
mn-branch = "br"@0b110000
          | "bne"@0b110001
          | "beq"@0b110010
          | "bpl"@0b110011
          | "bmi"@0b110100
          | "bvc"@0b110101
          | "bvs"@0b110110
          | "bcc"@0b110111
          | "bcs"@0b111000
          | "bge"@0b111001
          | "blt"@0b111010
          | "bgt"@0b111011
          | "ble"@0b111100
          | "bhi"@0b111101
          | "blos"@0b111110
          | "bhis"@0x137
          | "blo"@0x138

; compare a register with a 5-bit immediate and branch (opcode 0x28): the number is the condition, as in `set` (cc below); the two
; aliases are numbered above, as in the branch group
mn-cbranch = "cbne"@0b0001
           | "cbeq"@0b0010
           | "cbpl"@0b0011
           | "cbmi"@0b0100
           | "cbvc"@0b0101
           | "cbvs"@0b0110
           | "cbcc"@0b0111
           | "cbcs"@0b1000
           | "cbge"@0b1001
           | "cblt"@0b1010
           | "cbgt"@0b1011
           | "cble"@0b1100
           | "cbhi"@0b1101
           | "cblos"@0b1110
           | "cbhis"@0x107
           | "cblo"@0x108

; subtract one and branch
mn-sob = "sob"@0b111111

; tag branches (ISA 4.8): the sense bit
mn-tag = "btag"@0b0
       | "bntag"@0b1

; SOP: the reg field is the sub-opcode
mn-sop = "clr"@0b0000
       | "com"@0b0001
       | "inc"@0b0010
       | "dec"@0b0011
       | "neg"@0b0100
       | "tst"@0b0101
       | "adc"@0b0110
       | "sbc"@0b0111
       | "asl"@0b1000
       | "asr"@0b1001
       | "pushm"@0b1010
       | "popm"@0b1011
       | "jmp"@0b1100
       | "call"@0b1101
       | "push"@0b1110
       | "pop"@0b1111

; XFER: the reg field is the sub-opcode
mn-xfer = "jmpi"@0b0000
        | "calli"@0b0001
        | "jtag"@0b0010

; BESC: sub-opcode in parcel 1
mn-besc = "clz"@0b00000000
        | "ctz"@0b00000001
        | "clo"@0b00000010
        | "cto"@0b00000011
        | "popcnt"@0b00000100
        | "bswap"@0b00000101
        | "bswapw"@0b00000110
        | "bswapl"@0b00000111
        | "bitrev"@0b00001000
        | "ror"@0b00010000
        | "rori"@0b00010001
        | "rori32"@0b00010010
        | "dshr"@0b00100000
        | "extb"@0b00100001
        | "extzb"@0b00100010
        | "insb"@0b00100011
        | "xnorpop"@0b00110000
        | "clmull"@0b00110001
        | "clmulh"@0b00110010
        | "utf8len"@0b01000000
        | "utf8dec"@0b01000001
        | "utf8enc"@0b01000010
        | "rol"@0x111

; MBLK: sub-opcode in parcel 1
mn-mblk = "mcpy"@0b00000000
        | "mmov"@0b00000001
        | "mset"@0b00000010
        | "mcmp"@0b00000011
        | "mscn"@0b00000100
        | "mscnn"@0b00000101
        | "mval"@0b00000110

; AESC: sub-opcode in parcel 1
mn-aesc = "div"@0b00000000
        | "divu"@0b00000001
        | "mod"@0b00000010
        | "modu"@0b00000011
        | "mulhu"@0b00000100
        | "abs"@0b00001000
        | "min"@0b00010000
        | "minu"@0b00010001
        | "max"@0b00010010
        | "maxu"@0b00010011

; FESC: sub-opcode in parcel 1
mn-fesc = "fdiv"@0b00000000
        | "fsqrt"@0b00000001
        | "fadd32"@0b00001000
        | "fsub32"@0b00001001
        | "fmul32"@0b00001010
        | "fdiv32"@0b00001011
        | "fsqrt32"@0b00001100
        | "fcmp32"@0b00001101
        | "fmadd"@0b00010000
        | "fmsub"@0b00010001
        | "fnmadd"@0b00010010
        | "fnmsub"@0b00010011
        | "fmadd32"@0b00011000
        | "fmsub32"@0b00011001
        | "fnmadd32"@0b00011010
        | "fnmsub32"@0b00011011
        | "fneg"@0b00100000
        | "fabs"@0b00100001
        | "fcopysign"@0b00100010
        | "fmin"@0b00100011
        | "fmax"@0b00100100
        | "fclass"@0b00101000
        | "fclass32"@0b00101001
        | "frint"@0b00110000
        | "frintz"@0b00110001
        | "frintm"@0b00110010
        | "frintp"@0b00110011
        | "frinta"@0b00110100
        | "fcvtdq"@0b00111000
        | "fcvtqd"@0b00111001
        | "fcvtds"@0b00111010
        | "fcvtsd"@0b00111011
        | "fcvtsl"@0b00111100
        | "fcvtls"@0b00111101
        | "fcvtdqu"@0b00111110
        | "fcvtqud"@0b00111111
        | "fsflags"@0b01000000
        | "fadd16"@0b01010000
        | "fsub16"@0b01010001
        | "fmul16"@0b01010010
        | "fdiv16"@0b01010011
        | "fsqrt16"@0b01010100
        | "fcmp16"@0b01010101
        | "fmadd16"@0b01011000
        | "fmsub16"@0b01011001
        | "fnmadd16"@0b01011010
        | "fnmsub16"@0b01011011
        | "fclass16"@0b01011100
        | "fcvtsh"@0b01100000
        | "fcvths"@0b01100001
        | "fcvtdh"@0b01100010
        | "fcvthd"@0b01100011
        | "fcvthl"@0b01100100
        | "fcvtlh"@0b01100101
        | "fdivd"@0x100
        | "fsqrtd"@0x101
        | "fadds"@0x108
        | "fsubs"@0x109
        | "fmuls"@0x10A
        | "fdivs"@0x10B
        | "fsqrts"@0x10C
        | "fcmps"@0x10D
        | "fmaddd"@0x110
        | "fmsubd"@0x111
        | "fnmaddd"@0x112
        | "fnmsubd"@0x113
        | "fmadds"@0x118
        | "fmsubs"@0x119
        | "fnmadds"@0x11A
        | "fnmsubs"@0x11B
        | "fmind"@0x123
        | "fmaxd"@0x124
        | "fclassd"@0x128
        | "fclasss"@0x129
        | "frintd"@0x130
        | "frintdz"@0x131
        | "frintdm"@0x132
        | "frintdp"@0x133
        | "frintda"@0x134

; ATOM: the atomic words (errata 211; docs/encoding-work/rejudge-timer-iommu-irq-atomics.md F8 to F17).  The number is the handler's argument (MN_ATOM_*): bits 0 to 4 name the operation
; (compare and swap 0, swap 2, add 4, and 6, or 8, exclusive or 10, signed maximum 12, signed minimum 14, unsigned maximum 16, unsigned minimum 18; the odd number is the same operation with the
; `db` barrier; 20 the store-conditional, 21 the load-linked), bit 5 the size of the access: 0 eight bytes (the bare name), 1 four bytes (the name with the suffix `l` after the operation,
; before `db`: xaddl, xaddldb; the 4-byte load-linked is lll).  The encoding is in 57-enc-atomic.hbnf.
mn-atom = "cas"@0
        | "casdb"@1
        | "swap"@2
        | "swapdb"@3
        | "xadd"@4
        | "xadddb"@5
        | "xand"@6
        | "xanddb"@7
        | "xor_"@8
        | "xor_db"@9
        | "xxor"@10
        | "xxordb"@11
        | "xmax"@12
        | "xmaxdb"@13
        | "xmin"@14
        | "xmindb"@15
        | "xmaxu"@16
        | "xmaxudb"@17
        | "xminu"@18
        | "xminudb"@19
        | "sc"@20
        | "ll"@21
        | "casl"@32
        | "casldb"@33
        | "swapl"@34
        | "swapldb"@35
        | "xaddl"@36
        | "xaddldb"@37
        | "xandl"@38
        | "xandldb"@39
        | "xor_l"@40
        | "xor_ldb"@41
        | "xxorl"@42
        | "xxorldb"@43
        | "xmaxl"@44
        | "xmaxldb"@45
        | "xminl"@46
        | "xminldb"@47
        | "xmaxul"@48
        | "xmaxuldb"@49
        | "xminul"@50
        | "xminuldb"@51
        | "scl"@52
        | "lll"@53

; MESC: sub-opcode in parcel 1 (4 bits); the MOVU* names appear twice in the table, ld = n and st = n+1: numbered by the load
; MESC
mn-mesc = "movub"@0b0000
        | "movuw"@0b0010
        | "movul"@0b0100
        | "movuq"@0b0110
        | "addm"@0b1000
        | "subm"@0b1001
        | "bicm"@0b1010
        | "bism"@0b1011

