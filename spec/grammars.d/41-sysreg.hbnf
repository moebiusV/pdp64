; targets: asm spec
; The system registers, by name, as the number in the `sr` field of parcel 1 of mfsr and mtsr (ISA 4.11, errata 32, System v1: docs/pdp64-system-architecture.md
; section 15).  The registers listed in `sysreg-ro` are read only: a write is an illegal instruction (pdp64exec.c; tests/sim/sysreg-write-eva.s), and the
; assembler refuses it.  A number that is not listed is unassigned and also illegal.
sysreg = "ptbr"@0
       | "epc"@1
       | "eva"@2
       | "ecause"@3
       | "dmw0"@4
       | "dmw1"@5
       | "usp"@6
       | "ssp"@7
       | "epsw"@8
       | "vbr"@9
       | "mmuctl"@10
       | "asid"@11
       | "cpuid"@12
       | "htrap"@128    ; the hypervisor block, numbers 128 to 147 (errata 195, 196; docs/encoding-work/hypervisor-design.md 1.3).  Present only on a machine with the hypervisor strap HVE;
       | "hexitr"@129   ; with HVE clear every one of them is an illegal instruction; used by a guest (H = 0) it is an exit (exit code 18); at H = 1 it is the register.
       | "hepc"@130
       | "hepsw"@131
       | "heva"@132
       | "hcause"@133
       | "hgpa"@134
       | "hinsn"@135
       | "hvbr"@136
       | "gtbr"@137
       | "virq"@138
       | "vivec"@139
       | "vtoff"@140
       | "vcpuid"@141
       | "geva"@142     ; the write alias of the guest's EVA (EVA and ECAUSE are read only)
       | "gecause"@143  ; the write alias of the guest's ECAUSE
       | "gksp"@144     ; the guest's kernel-bank R14
       | "gkdp"@145     ; the guest's kernel-bank DP
       | "gsdp"@146     ; the guest's supervisor-bank DP
       | "gudp"@147     ; the guest's user-bank DP

; The read-only system registers (the numbers of `sysreg`)
sysreg-ro = "eva"@2
          | "ecause"@3
          | "cpuid"@12
          | "hexitr"@129
          | "heva"@132
          | "hcause"@133
          | "hgpa"@134
          | "hinsn"@135
