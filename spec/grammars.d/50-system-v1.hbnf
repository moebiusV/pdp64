; targets: spec
; pdp64 System v1 (docs/pdp64-system-architecture.md section 15): the numbers of privileged mode, exceptions, interrupts, the memory-management unit and
; the devices of the virt machine.  Written once, here, as enum rules; tools/mkgrammar.py generates a #define for each in build/pdp64-consts.h (the
; enumerator "pri" of the rule psw is PSW_PRI), and the assembler, the shared core (common/pdp64exec.c), sim64, the QEMU target and the tests use them
; from there.  (The system-register numbers are in 41-sysreg.hbnf, because the assembler's grammar names them.)
; Rules of this file are not part of the instruction grammar; they follow the layout of the other number parts (30-mn-core.hbnf) so that one reader serves all; target spec only, hbnf does not read this part (a 40-bit constant does not fit an enum constant).

; The processor status word, 16 bits: the value is the position of the field's lowest bit.  Bits 0 to 3 are reserved and read as zero: the machine has no condition codes.
psw = "t"@4
    | "pri"@5
    | "mode"@8
    | "prev"@10

; The widths of the multi-bit fields (the others are one bit); bits 12 to 15 are reserved and read as zero.
psw-width = "pri"@3
          | "mode"@2
          | "prev"@2

; The modes, as on the PDP-11: kernel 0, supervisor 1, user 3 (2 is reserved: an illegal instruction when it is loaded into the PSW).
mode = "kernel"@0
     | "supervisor"@1
     | "user"@3

; The vector numbers; ECAUSE equals the vector number.  The table has `count` entries of eight bytes at the physical address VBR + 8 * vector.
vector = "reset"@0
       | "machine-check"@1
       | "illegal"@2
       | "privileged"@3
       | "misaligned"@4
       | "noncanonical"@5
       | "ifault"@6
       | "lfault"@7
       | "sfault"@8
       | "iprot"@9
       | "lprot"@10
       | "sprot"@11
       | "divzero"@12
       | "busfault"@13
       | "lpad"@14
       | "bpt"@15
       | "check"@16
       | "hexit"@17         ; the hypervisor's table only (errata 195, 196; the design 1.6): the instruction exit; 18, 19, 20 the guest-physical instruction, load and store faults.  No guest table is indexed by them
       | "gifault"@18
       | "glfault"@19
       | "gsfault"@20
       | "irq-base"@32
       | "timer"@32
       | "console-in"@33
       | "console-out"@34
       | "pcie-inta"@35
       | "pcie-intb"@36
       | "pcie-intc"@37
       | "pcie-intd"@38
       | "iommu"@39
       | "trap-base"@256
       | "count"@512

; The page-table entry, 64 bits: the position of the field's lowest bit.  A non-leaf entry has V = 1 and R = W = X = 0.  The physical page number is
; physical address bits 12 to 39, in place; every bit not named here must be zero.
pte = "v"@0
    | "r"@1
    | "w"@2
    | "x"@3
    | "u"@4
    | "g"@5
    | "a"@6
    | "d"@7
    | "mt"@8
    | "ppn"@12

pte-width = "mt"@2
          | "ppn"@28

; The memory type MT of a page: cached, uncached, device weakly ordered, device strongly ordered.  The number is the strictness: the type of an access that
; goes through several terms (the stage-1 entry, the stage-2 entry, the platform map) is the largest of them.  "device" is the strongly ordered one.
mt = "cached"@0
   | "uncached"@1
   | "device-weak"@2
   | "device"@3

; The geometry: 4 KB pages, three levels of 512 entries, a 39-bit virtual address (bits 63 to 39 must equal bit 38), a 40-bit physical address.
mmu = "page-bits"@12
    | "level-bits"@9
    | "levels"@3
    | "va-bits"@39
    | "pa-bits"@40

; MMUCTL bits (the system register mmuctl).
mmuctl = "enable"@0

; The interrupt priority levels of the devices.
irq-level = "timer"@6
          | "console"@4
          | "pcie"@5
          | "iommu"@5

; The physical memory map of the pdp64-virt machine.  Bit 39 of the 40-bit physical address is the space bit (errata 60): clear is memory, set is device space.  RAM starts
; at 0 (at most `ram-max` bytes); each device has a 4 KB page in the upper half.  The IOMMU's register block (`iommu`, in the root complex's own block) and the PCI Express host bridge
; (the configuration window `pcie-ecam`, one megabyte for each bus, the memory window `pcie-mmio` and the I/O window `pcie-pio`, each with its size) are PROVISIONAL (errata 194):
; the placement of the configuration space and the windows is J.2.1, still open, and no address bit selects device space (errata 97).  The IOMMU block is the next page after the console; the PCI Express windows lie above `dev-end` (nothing answers
; at `dev-end` itself: tests/sim/sys-exc.S); none clashes with anything.  The model's machine file takes every one of these from here.
map = "ram"@0
    | "ram-max"@0x10000000
    | "space-bit"@39
    | "dev"@0x8000000000
    | "timer"@0x8000000000
    | "console"@0x8000001000
    | "dev-end"@0x8010000000
    | "iommu"@0x8000002000
    | "vtimer"@0x8000003000
    | "pcie-ecam"@0x8100000000
    | "pcie-ecam-size"@0x1000000
    | "pcie-mmio"@0x8200000000
    | "pcie-mmio-size"@0x10000000
    | "pcie-pio"@0x8300000000
    | "pcie-pio-size"@0x10000

; The virtual timer page of the hypervisor mode (errata 195, 196; design 1.9): the core's own page, present only on a machine with the hypervisor strap; the next page after the IOMMU block.  It has the registers of
; the timer below (the same offsets and bits) and a counter that reads the real counter minus VTOFF; its expiry sets bit 6 of VIRQ.  The address is PROVISIONAL like the rest of the map (J.2.1).
; The timer: a 64-bit free-running counter that counts at `hz` ticks a second of QEMU's virtual clock, a 64-bit compare, and a control/status register.
; The interrupt (level irq-level timer, vector vector timer) is asserted while counter >= compare and CTL enable is 1.  PENDING reads counter >= compare.
timer-reg = "counter"@0
          | "compare"@8
          | "control"@16

timer-ctl = "enable"@0
          | "pending"@1

timer-clock = "hz"@10000000

; The console, in the spirit of the KL11: four 64-bit registers.  RXDB reads the received byte (and clears RXCS READY), TXDB takes the byte to send.  Output is
; instantaneous in the virt machine, so TXCS READY is always 1.  READY is bit 7 and IE (interrupt enable) bit 6 of both status registers, as in the KL11.  Input
; interrupts with vector vector console-in while RXCS READY and IE; output with vector console-out while TXCS READY and IE (that is, while IE); both at level
; irq-level console.  The registers are read and written with 64-bit (or smaller) accesses at their offsets.
console-reg = "rxcs"@0
            | "rxdb"@8
            | "txcs"@16
            | "txdb"@24

console-csr = "ie"@6
            | "ready"@7
