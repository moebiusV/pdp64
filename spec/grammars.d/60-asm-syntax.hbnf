; targets: asm
; The syntax of the assembly language: statements, directives, operands, expressions (docs/asm-syntax.md).  The words (mnemonics, registers, system registers) are other parts.
asm = line

; a name is a word token; with one in the grammar every literal that begins with two letters or more is a whole word (`bit` is not the front of
; `bitrev`, `ror` not the front of `ror32`), in any order, and a name cannot be one of those words.  The one-letter choices below are character
; classes in rules of their own, which keeps them character-level in this mode.
word_start = idstart | DIGIT
wordchars = idchar
keywords-on = word          ; names the word token (this is what turns whole-word keywords on); nothing uses it


ws = SP | HTAB | comment
comment = ( ";" | "//" ) *( 0x01..0x09 | 0x0B..0xD7FF | 0xE000..0x10FFFF )
line = *label [ stmt ]

; NASM also lets a datum's name stand without the colon: `msg db 'hi', 0`
; (not an instruction word and not a directive: `lea dd, r10` is an instruction whose operand is the symbol dd, not the label `lea` before a datum, and `.quad resb` is the directive)
label = symbol ":" | !insnword !( "." dname ) symbol &dkword
insnword = mnemonic | mn-sysreg
dkword = "db" | "dw" | "dd" | "dq" | "resb" | "resw" | "resd" | "resq" | "DB" | "DW" | "DD" | "DQ" | "RESB" | "RESW" | "RESD" | "RESQ"
; (the instruction before the assignment: `mov =5, r1` starts like the assignment `mov = 5`, and a mnemonic is never a symbol to assign)
stmt = directive | vecinsn | instruction | srinsn | assign | dbdir | procdir | endpdir | nasmdir | secdir | timesdir

; `sym = expr` or, MASM's way, `sym equ expr`
assign = symbol eqw expr
eqw = "=" | "equ"
; MASM and Turbo Pascal spellings of `.byte` and `.word`: `db 1, 2, "text"`, `dw 1000`
dbdir = dbname [ dargs ]
dbname = "db" | "dw" | "dd" | "dq" | "DB" | "DW" | "DD" | "DQ"
; `name proc` defines the label `name`; `name endp` (or `endp`) closes it and does nothing
procdir = symbol "proc"
endpdir = "endp" | symbol "endp"
directive = "." dname [ dargs ]
dname = "chk" | "encode" | "fill" | "pool" | "text" | "data" | "bss" | "globl" | "comm" | "byte" | "word" | "long" | "quad"
      | "even" | "align" | "space" | "ascii" | "lpad" | "if" | "else" | "endif" | "bugrec"
dargs = darg *( "," darg )
; NASM's `'text'` (no escapes; two or more characters, so `'a'` is the character) and `` `text\n` `` (C's escapes) are strings too
darg = string | bqstring | sqstring | expr

; --- NASM's statements (errata 162): the directives without the dot, in the grammar like the others.  They do what the dotted ones do:
;   global a, b = .globl      extern a = nothing (an undefined symbol is external)     bits 64      default rel, cpu x = nothing
;   align n, alignb n = .align       resb|resw|resd|resq n = .space n, 2n, 4n, 8n       dd, dq = .long, .quad (db and dw are above)
;   section .text|.data|.bss (and .rodata, .rdata = .data; options after the name are ignored)
;   times n db|dw|dd|dq v = .fill n, size, v
nasmdir  = nname [ dargs ]
nname    = "global" | "extern" | "bits" | "default" | "cpu" | "align" | "alignb" | "resb" | "resw" | "resd" | "resq"
         | "GLOBAL" | "EXTERN" | "BITS" | "DEFAULT" | "CPU" | "ALIGN" | "ALIGNB" | "RESB" | "RESW" | "RESD" | "RESQ"
secdir   = ( "section" | "segment" | "SECTION" | "SEGMENT" ) symbol *secopt
secopt   = symbol [ "=" expr ]
timesdir = ( "times" | "TIMES" ) expr tdata darg
tdata    = "db" | "dw" | "dd" | "dq" | "DB" | "DW" | "DD" | "DQ"

; the vector words (v..., and nothing else starts with v) are the only instructions that name the vector registers v0..v15:
; for every other instruction v0 is a name like any other (`lea v0, r10`), so a C global may be called v0.  Written before `instruction`: that would take `v0` as a symbol
vecinsn = &vchar !map-words mnemonic [ voperand *( "," voperand ) ]
vchar = 0x76
voperand = vregop | operand
instruction = !map-words mnemonic [ operand *( "," operand ) ]
; the system-register moves: the register is a word of its own, and only in that operand position (`mfsr r1, ptbr`, `mtsr ptbr, r1`)
srinsn = mn-sysreg ( sysregw "," operand | operand "," sysregw | operand *( "," operand ) )
sysregw = sysreg
; `mnemonic` (every group mn-NAME of the parts, in the order of the parts) is GENERATED by tools/grammars_d.py into 90-mnemonic.hbnf: a new group is a new part and nothing here changes

; --- operands (ISA section 5) -----------------------------------------------------------------------------------
; the order of `opbody` matters (the first that matches is taken, and the C that reads the tree numbers the alternatives, as64/asmir.h):
; based2 (`r5+8`, `r5-8`: parsed only so that as64 refuses it with a message that gives `8(r5)`; the one spelling of a displacement is `expr(base)`) and atindexed (AT&T's `(r1,r2,4)` and `8(r1,r2,4)`) come before regop and bare
opbody = markop | immop | absop | postinc | predec | predec2 | indexed | based | atindexed | based2 | regop | bare | poolop
; an operand is a body.  The width and kind of an instruction are a suffix of its mnemonic (61-asm-suffixes.hbnf); only `fcvt`, which has two formats, writes them on its operands.
operand = opbody
; a register with a format mark directly after it, `r1.f32`, `sp.s64`: the register name and the mark are one token, so a symbol that merely looks like it (`buf.f32`, `x.s8`, a label `r1.f32:`) is not one,
; and the mark is a letter and digits (the sizes are checked where the instruction is read, as64: only `fcvt` accepts a mark).  First among the operands, before `bare`, which would take `r1.f32` as a symbol
markop  = markreg !idchar
markreg = r"(r([12][0-9]|3[01]|[0-9])|sp|fp)\.[a-z][0-9]+"
; an immediate is `$expr`, as the V7 assembler writes it; `#expr`, the spelling of MACRO-11, is accepted too.  A register after the marker (`$r1`, `$sp`) is no expression: as64 refuses it
; with a message (a register is written without a sigil), and so it does a `$` that stands anywhere else (asmp.c)
immop   = ( "$" | "#" ) expr
absop   = "@" expr
regop   = reg
; a vector register v0..v15 (the vec block), only in `voperand`
vregop  = vnum
postinc = "(" reg ")" "+" [ expr ]
predec  = "-" "(" reg ")"
predec2 = "(" reg ")" "-" expr
; with a displacement, or without: `(r1)` would otherwise be taken for the parenthesized expression r1
; the form without a displacement is tried first: an optional expr would take "(sp)" as a parenthesized symbol
indexed = "(" reg ")" "(" reg [ "*" scale ] ")" | expr "(" reg ")" "(" reg [ "*" scale ] ")"
based   = "(" basereg ")" | expr "(" basereg ")"
atindexed = "(" reg "," reg [ "," scale ] ")" | expr "(" reg "," reg [ "," scale ] ")"
; refused by as64 (asmp.c), which says to write expr(base); `(r5)-8` and `(r5)+` are other operands (the base register changes)
based2  = basereg ( "+" | "-" ) expr
bare    = expr
; a literal-pool load (`mov =0x123456789ABC, r1`): the constant goes to the literal pool, the operand is the pool entry, a pc-relative memory operand.  Written last: nothing else starts with "="
poolop  = "=" expr

; R0..R15; SP is R14 and FP is R13 (ISA 2.1); PC and DP only as a base register
; (a register is recognized by its characters, not as a word: the whole-word scan counts `.` and `-` as word characters, so `r5-8` would not be seen; `sp-8` is a register and a displacement)
reg      = regtok
regtok   = rbody !idchar
rbody    = r"r([0-9]|[12][0-9]|3[01])|sp|fp"
basereg  = reg | basespec
scale    = "1" | "2" | "4" | "8"

; --- expressions ----------------------------------------------------------------------------------------------------
expr    = term *( addop term )
addop   = "+" | "-" | "|" | "^" | "!"
term    = unary *( mulop unary )
mulop   = "*" | "/" | "%" | "&" | "<<" | ">>"
; `<x` is the low byte of x and `>x` its high byte (the 6502 assemblers' operators); `a ! b` is `a | ~b`, the V7 assembler's or-not
unary   = *( "-" | "~" | "!" | "<" | ">" ) primary
; a number is a whole bareword: 3dfx is a name, 3 and 0x3d and 1f are not.  A number is decimal, or 0x hexadecimal, 0o octal, 0b binary, the prefixes in lower case; a decimal number with a leading
; zero (`077`) and every number of an older spelling (`0FFh`, `17q`, `10d`, `0X1F`) is read by as64 (asmp.c) so that it can say what to write instead.  A value mark (`.s8 .u8 ... .u64`, `.f8 ... .f64`) after a number or a
; symbol is read by as64 too: `limit.u16` is one word to this grammar, and a name that ends in a mark is reserved (as64 refuses to define it)
primary = prefixnum !idchar | localref !idchar | decnum !idchar | charlit | mcharlit | fpconst | symbol | "." | "(" expr ")" | "[" expr "]"

; a floating-point constant `f16(1.5)`, `f32(0.1)`, `f64(2)`: the name, a parenthesis at once, the literal (as64 reads and converts it: asmp.c, fpconv.c), and a value mark after it (`f64(1.5).s64`).  The three names
; are reserved (a label cannot be called f64); `inf`, `nan` and `nan(p)` are words of this form only
fpconst  = fpname "(" fpbody ")" [ fpmarkw ]
; one inner parenthesis is allowed for the payload of a NaN, `nan(0x1)`
fpbody   = *fpch [ "(" *fpch ")" ]
fpname   = "f16" | "f32" | "f64"
fpch     = 0x20..0x27 | 0x2A..0x3A | 0x3C..0x7E | uni
fpmarkw = fpmark !idchar
fpmark   = r"\.[suf](8|16|32|64)"

prefixnum = hexnum | binnum | octnum
hexnum   = "0" xch 1*HEXDIG
xch      = 0x78
binnum   = "0" bch 1*( "0" | "1" )
bch      = 0x62
octnum   = "0" och 1*( "0" | "1" | "2" | "3" | "4" | "5" | "6" | "7" )
och      = 0x6F
decnum   = 1*DIGIT
charlit  = 0x27 chch 0x27
; NASM's `'abcd'`: up to eight characters, the first the lowest byte
mcharlit = 0x27 chch 1*chch 0x27
chch     = 0x20..0x26 | 0x28..0x5B | 0x5D..0x7E | uni | escape
localref = 1*DIGIT fbch
fbch     = 0x66 | 0x62
; a name cannot be `r` followed only by digits: r0..r31 are registers (05-registers.hbnf) and anything else of that shape (r32, r99) is an error,
; not a name.  So a name either starts with something other than `r`, or is `r` followed by digits and then something that is not a digit.
; a name is never a valid number: `0x1f` is a number and cannot be a label, assigned or declared; `3dfx` is a name.  The one thing that looks like a number and is a label is the numeric local
; label, digits only (`1:`, referenced as `1b` and `1f`).  A name that must have such a spelling is written in double quotes.
symbol   = !numtok ( ( oidstart | DIGIT ) *idchar | rname | qname )
numtok   = prefixnum !idchar
oidstart = 0x41..0x5A | 0x61..0x71 | 0x73..0x7A | 0x5F | 0x2E | uni
rname    = 0x72 *DIGIT nodig *idchar | 0x72
nodig    = ALPHA | 0x5F | 0x2E | 0x24 | uni
idstart  = ALPHA | "_" | "." | uni
idchar   = idstart | DIGIT | "$"
uni      = 0x80..0xD7FF | 0xE000..0x10FFFF
qname    = 0x22 1*qnch 0x22
qnch     = 0x20..0x21 | 0x23..0xD7FF | 0xE000..0x10FFFF
string   = 0x22 *strch 0x22
sqstring = 0x27 2*sqch 0x27
sqch     = 0x20..0x26 | 0x28..0x7E | uni
bqstring = 0x60 *bqch 0x60
bqch     = 0x20..0x5B | 0x5D..0x5F | 0x61..0x7E | uni | escape
strch    = 0x20..0x21 | 0x23..0x5B | 0x5D..0x7E | uni | escape
escape   = esc1 | esc-hex | esc-u4 | esc-u8 | esc-oct
esc1     = 0x5C escch
escch    = 0x6E | 0x74 | 0x72 | 0x61 | 0x62 | 0x66 | 0x76 | 0x30 | 0x5C | 0x27 | 0x22
esc-hex  = 0x5C 0x78 1*2HEXDIG
esc-u4   = 0x5C 0x75 4HEXDIG
esc-u8   = 0x5C 0x55 8HEXDIG
esc-oct  = 0x5C OCT *2OCT
OCT      = 0x30..0x37
