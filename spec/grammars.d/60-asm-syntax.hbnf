; targets: asm
; The syntax of the assembly language: statements, directives, operands, expressions (docs/asm-syntax.md).  The words (mnemonics, registers, system registers) are other parts.
asm = line

; a name is a word token; with one in the grammar every literal that begins with two letters or more is a whole word (`bit` is not the front of
; `bitrev`, `ror` not the front of `rori`), in any order, and a name cannot be one of those words.  The one-letter choices below are character
; classes in rules of their own, which keeps them character-level in this mode.
word_start = idstart | DIGIT
wordchars = idchar
keywords-on = word          ; names the word token (this is what turns whole-word keywords on); nothing uses it


ws = SP | HTAB | comment
comment = ( ";" | "//" ) *( 0x01..0x09 | 0x0B..0xD7FF | 0xE000..0x10FFFF )
line = *label [ stmt ]

; NASM also lets a datum's name stand without the colon: `msg db 'hi', 0`
; (not an instruction word and not a directive: `lea dd, r10` is an instruction whose operand is the symbol dd, not the label `lea` before a datum, and `.quad resb` is the directive)
label = symbol ":" | !insnword !( "." dname ) symbol &dkword
insnword = mnemonic | mn-cond | mn-sysreg
dkword = "db" | "dw" | "dd" | "dq" | "resb" | "resw" | "resd" | "resq" | "DB" | "DW" | "DD" | "DQ" | "RESB" | "RESW" | "RESD" | "RESQ"
; (the instruction before the assignment: `movq =5, r1` starts like the assignment `movq = 5`, and a mnemonic is never a symbol to assign)
stmt = directive | vecinsn | instruction | condinsn | srinsn | assign | dbdir | procdir | endpdir | nasmdir | secdir | timesdir

; `sym = expr` or, MASM's way, `sym equ expr`
assign = symbol eqw expr
eqw = "=" | "equ"
; MASM and Turbo Pascal spellings of `.byte` and `.word`: `db 1, 2, "text"`, `dw 1000`
dbdir = dbname [ dargs ]
dbname = "db" | "dw" | "dd" | "dq" | "DB" | "DW" | "DD" | "DQ"
; `name proc` defines the label `name`; `name endp` (or `endp`) closes it and does nothing
procdir = symbol "proc"
endpdir = "endp" | symbol "endp"
directive = "." dname [ dargs ]
dname = "chk" | "encode" | "fill" | "pool" | "text" | "data" | "bss" | "globl" | "comm" | "byte" | "word" | "long" | "quad"
      | "even" | "align" | "space" | "ascii" | "lpad" | "if" | "else" | "endif" | "bugrec"
dargs = darg *( "," darg )
; NASM's `'text'` (no escapes; two or more characters, so `'a'` is the character) and `` `text\n` `` (C's escapes) are strings too
darg = string | bqstring | sqstring | expr

; --- NASM's statements (errata 162): the directives without the dot, in the grammar like the others.  They do what the dotted ones do:
;   global a, b = .globl      extern a = nothing (an undefined symbol is external)     bits 64      default rel, cpu x = nothing
;   align n, alignb n = .align       resb|resw|resd|resq n = .space n, 2n, 4n, 8n       dd, dq = .long, .quad (db and dw are above)
;   section .text|.data|.bss (and .rodata, .rdata = .data; options after the name are ignored)
;   times n db|dw|dd|dq v = .fill n, size, v     (n may use $ and $$: times 510-($-$$) db 0)
nasmdir  = nname [ dargs ]
nname    = "global" | "extern" | "bits" | "default" | "cpu" | "align" | "alignb" | "resb" | "resw" | "resd" | "resq"
         | "GLOBAL" | "EXTERN" | "BITS" | "DEFAULT" | "CPU" | "ALIGN" | "ALIGNB" | "RESB" | "RESW" | "RESD" | "RESQ"
secdir   = ( "section" | "segment" | "SECTION" | "SEGMENT" ) symbol *secopt
secopt   = symbol [ "=" expr ]
timesdir = ( "times" | "TIMES" ) expr tdata darg
tdata    = "db" | "dw" | "dd" | "dq" | "DB" | "DW" | "DD" | "DQ"

; the vector words (v..., and nothing else starts with v) are the only instructions that name the vector registers v0..v15:
; for every other instruction v0 is a name like any other (`lea v0, r10`), so a C global may be called v0.  Written before `instruction`: that would take `v0` as a symbol
vecinsn = &vchar mnemonic [ voperand *( "," voperand ) ]
vchar = 0x76
voperand = vregop | operand
instruction = mnemonic [ operand *( "," operand ) ]
; an instruction that takes a condition: the condition is a word of its own, then the operands (`set eq, r1`)
condinsn = mn-cond ccw "," operand *( "," operand )
ccw = cc | ccalias
; the system-register moves: the register is a word of its own, as the condition of `set` is, and only in that operand position (`mfsr r1, ptbr`, `mtsr ptbr, r1`)
srinsn = mn-sysreg ( sysregw "," operand | operand "," sysregw | operand *( "," operand ) )
sysregw = sysreg
; `mnemonic` (every group mn-NAME of the parts, in the order of the parts) is GENERATED by tools/grammars_d.py into 90-mnemonic.hbnf: a new group is a new part and nothing here changes

; --- operands (ISA section 5) -----------------------------------------------------------------------------------
; the order matters (the first that matches is taken, and the C that reads the tree numbers the alternatives, as64/asmir.h):
; based2 (`r5+8`, `r5-8`, a synonym of `8(r5)`) and atindexed (AT&T's `(r1,r2,4)` and `8(r1,r2,4)`) come before regop and bare
operand = immop | absop | postinc | predec | predec2 | indexed | based | atindexed | based2 | regop | bare | poolop
; `#expr`, or `$expr` as AT&T and the Microsoft assemblers write it
immop   = ( "#" | "$" ) expr
absop   = "@" expr
regop   = reg
; a vector register v0..v15 (the vec block), only in `voperand`
vregop  = vnum
postinc = "(" reg ")" "+" [ expr ]
predec  = "-" "(" reg ")"
predec2 = "(" reg ")" "-" expr
; with a displacement, or without: `(r1)` would otherwise be taken for the parenthesized expression r1
; the form without a displacement is tried first: an optional expr would take "(sp)" as a parenthesized symbol
indexed = "(" reg ")" "(" reg [ "*" scale ] ")" | expr "(" reg ")" "(" reg [ "*" scale ] ")"
based   = "(" basereg ")" | expr "(" basereg ")"
atindexed = "(" reg "," reg [ "," scale ] ")" | expr "(" reg "," reg [ "," scale ] ")"
based2  = basereg ( "+" | "-" ) expr
bare    = expr
; a literal-pool load (`movq =0x123456789ABC, r1`): the constant goes to the literal pool, the operand is the pool entry, a pc-relative memory operand.  Written last: nothing else starts with "="
poolop  = "=" expr

; R0..R15; SP is R14 and FP is R13 (ISA 2.1); PC and DP only as a base register
reg      = rnum | ralias | pctnum | pctalias
; AT&T's `%r1`: the percent sign is accepted before a register name and means nothing
pctnum   = "%" rnum
pctalias = "%" ralias
basereg  = reg | basespec
scale    = "1" | "2" | "4" | "8"

; --- expressions ----------------------------------------------------------------------------------------------------
expr    = term *( addop term )
addop   = "+" | "-" | "|" | "^" | "!"
term    = unary *( mulop unary )
mulop   = "*" | "/" | "%" | "&" | "<<" | ">>"
; `<x` is the low byte of x and `>x` its high byte (the 6502 assemblers' operators); `a ! b` is `a | ~b`, the V7 assembler's or-not
unary   = *( "-" | "~" | "!" | "<" | ">" ) primary
; a number is a whole bareword: 3dfx is a name, 3 and 0x3d and 1f are not
primary = prefixnum !idchar | suffnum !idchar | localref !idchar | decnum !idchar | charlit | mcharlit | dollar | symbol | "." | "(" expr ")" | "[" expr "]"

prefixnum = hexnum | binnum | octnum
hexnum   = "0" xch 1*HEXDIG
xch      = 0x78 | 0x58
binnum   = "0" bch 1*( "0" | "1" )
bch      = 0x62 | 0x42
octnum   = "0" och 1*( "0" | "1" | "2" | "3" | "4" | "5" | "6" | "7" )
och      = 0x6F | 0x4F
decnum   = 1*DIGIT
charlit  = 0x27 chch 0x27
; NASM's numbers with a suffix: 0A6h, 1001b, 17q or 17o, 10d or 10t.  They overlap two things, which as64 settles when it evaluates (as64.c): `1b` is also the nearest numeric
; label 1 before this line, and a name such as `A6h` may be a symbol.  A label that is defined wins in both; with none, the token is the number.
suffnum  = hexsuf | binsuf | octsuf | decsuf
hexsuf   = 1*HEXDIG ( "h" | "H" )
binsuf   = 1*( "0" | "1" ) ( "b" | "B" )
octsuf   = 1*OCT ( "q" | "Q" | "o" | "O" )
decsuf   = 1*DIGIT ( "d" | "D" | "t" | "T" )
; NASM's `'abcd'`: up to eight characters, the first the lowest byte; `$` is the location counter and `$$` the start of the section (a `$` that is not followed by a name)
mcharlit = 0x27 chch 1*chch 0x27
dollar   = ( "$$" | "$" ) !idchar
chch     = 0x20..0x26 | 0x28..0x5B | 0x5D..0x7E | uni | escape
localref = 1*DIGIT fbch
fbch     = 0x66 | 0x62
; a name cannot be `r` followed only by digits: r0..r31 are registers (05-registers.hbnf) and anything else of that shape (r32, r99) is an error,
; not a name.  So a name either starts with something other than `r`, or is `r` followed by digits and then something that is not a digit.
; a name is never a valid number (the author, errata 163): `A6h`, `1001b`, `0x1f`, `17q` are numbers and cannot be labels, assigned or declared; `3dfx` is a name.  The one thing that
; looks like a number and is a label is the numeric local label, digits only (`1:`, referenced as `1b` and `1f`).  A name that must have such a spelling is written in double quotes.
symbol   = !numtok ( ( oidstart | DIGIT ) *idchar | rname | qname )
numtok   = ( prefixnum | suffnum ) !idchar
oidstart = 0x41..0x5A | 0x61..0x71 | 0x73..0x7A | 0x5F | 0x2E | uni
rname    = 0x72 *DIGIT nodig *idchar | 0x72
nodig    = ALPHA | 0x5F | 0x2E | 0x24 | uni
idstart  = ALPHA | "_" | "." | uni
idchar   = idstart | DIGIT | "$"
uni      = 0x80..0xD7FF | 0xE000..0x10FFFF
qname    = 0x22 1*qnch 0x22
qnch     = 0x20..0x21 | 0x23..0xD7FF | 0xE000..0x10FFFF
string   = 0x22 *strch 0x22
sqstring = 0x27 2*sqch 0x27
sqch     = 0x20..0x26 | 0x28..0x7E | uni
bqstring = 0x60 *bqch 0x60
bqch     = 0x20..0x5B | 0x5D..0x5F | 0x61..0x7E | uni | escape
strch    = 0x20..0x21 | 0x23..0x5B | 0x5D..0x7E | uni | escape
escape   = esc1 | esc-hex | esc-u4 | esc-u8 | esc-oct
esc1     = 0x5C escch
escch    = 0x6E | 0x74 | 0x72 | 0x61 | 0x62 | 0x66 | 0x76 | 0x30 | 0x5C | 0x27 | 0x22
esc-hex  = 0x5C 0x78 1*2HEXDIG
esc-u4   = 0x5C 0x75 4HEXDIG
esc-u8   = 0x5C 0x55 8HEXDIG
esc-oct  = 0x5C OCT *2OCT
OCT      = 0x30..0x37
