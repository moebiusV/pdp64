; pdp64/r20: what the fields of the instruction format are called, for the bit-layout charts of the manual (tools/mkmanual.py, tools/manual/layouts.py).
;
; The widths and the positions of the fields are not here: they are the bit rules of spec/pdp64.hbnf.in (parcel 0 is `len:2 opc:6 reg:4 low:4`, the body is
; selected by the guards of the alternatives), and the numbers (opcodes, sub-opcodes, modes) are the enums of spec/pdp64-mnemonics.hbnf.  What the grammar
; does not say is what a field is *for* in each class of instruction; that is written here, once, and the charts use it.
;
; Each literal is  "class:field=label"  or  "class:field@len=label"  (the label for one length only).  The classes are the kinds of tools/mkmanual.py:
; mem (moves, LEA, the ALU), br, cb, sob, tag, sop, xfer, besc, mblk, aesc, fesc, atom, mesc, sysn, sysx, sysreg, sys.  A field with no label is drawn by its
; name in the grammar.  A label `-` is a field that the instruction leaves unused.
layout-role = "mem:reg=Rd" | "mem:low@0=Rs" | "mem:low=mode" | "mem:rm=rm" | "mem:rx=rx" | "mem:s=scale" | "mem:d=displacement" | "mem:pad=pad"
            | "br:reg@1=-" | "br:low@1=-" | "br:reg@2=-" | "br:low@2=-" | "br:d=displacement (parcels)"
            | "cb:reg=Rd" | "cb:low=cond" | "cb:imm=imm" | "cb:d=displacement (parcels)" | "cb:cond=cond" | "cb:imm16=imm16"
            | "cbrr:reg=Ra" | "cbrr:low=Rb" | "cbrr:cond=cond" | "cbrr:d=displacement (parcels)"
            | "sob:reg=Rn" | "sob:low=-" | "sob:d=displacement (parcels)"
            | "tag:reg=Rn" | "tag:d=displacement (parcels)"
            | "sop:reg=sub-opcode" | "sop:low@0=rm" | "sop:low=mode" | "sop:rm=rm" | "sop:rx=rx" | "sop:s=scale" | "sop:d=displacement" | "sop:pad=pad"
            | "xfer:reg=sub-opcode" | "xfer:low@0=rm" | "xfer:low=mode" | "xfer:rm=rm" | "xfer:rx=rx" | "xfer:s=scale" | "xfer:d=displacement" | "xfer:pad=pad"
            | "besc:reg=Rd" | "besc:low=Rs" | "besc:sub=sub-opcode" | "besc:t=Rt" | "besc:x=Ru" | "besc:count=count" | "besc:pos=pos" | "besc:width=width"
            | "aesc:reg=Rd" | "aesc:low=Rs" | "aesc:sub=sub-opcode" | "aesc:t=Rt" | "aesc:x=Ru"
            | "fesc:reg=Rd" | "fesc:low=Rs" | "fesc:sub=sub-opcode" | "fesc:t=Rt" | "fesc:x=Ru"
            | "atom:reg=Rd" | "atom:low=Rs" | "atom:sub=sub-opcode" | "atom:t=Rt" | "atom:x=Ru"
            | "mblk:reg=Rd" | "mblk:low=Rs" | "mblk:sub=sub-opcode" | "mblk:t=Rn" | "mblk:x=flags"
            | "mesc:reg=Rs/Rd" | "mesc:low=mode" | "mesc:sub=sub-opcode" | "mesc:rm=rm" | "mesc:d=displacement"
            | "sysn:reg=class" | "sysn:low=minor" | "sysn:p=operand" | "sysx:reg=class" | "sysx:low=minor" | "sysx:sub=sub-opcode" | "sysx:pad=pad"
            | "sysreg:reg=class" | "sysreg:low=minor" | "sysreg:sr=system register" | "sysreg:r=Rd/Rs" | "sysreg:pad=pad"
            | "sys:reg=class" | "sys:low=Rs / imm" | "sys:rd=Rd" | "sys:n=vector" | "sys:pad=pad" | "sys:p=operand"

; What the grammar leaves inside a neighbouring field.  layout-merge  "class:a+b@len=label"  joins two fields of parcel 0 into one box (the 8-bit
; displacement of the short branch is the 8 bits of `reg` and `low`); layout-split  "class:field=a:w,b:w"  cuts one field in two (the tag branch's
; `low` is a sense bit and a 3-bit tag).
layout-merge = "br:reg+low@0=displacement (parcels)"
layout-split = "tag:low=sense:1,tag:3"

; The one-line description of the fields of each class, printed under the chart.
layout-note = "mem:`reg` is the register `Rd` (the source of a store); `low` is a second register (`Rs`) at `len = 00` and the addressing mode from `len = 01`; the extension parcels hold the operand (section 9.5)."
            | "br:The displacement is signed and counts 2-byte parcels from the first parcel of the instruction."
            | "cb:`low` is the condition; the immediate and the displacement are signed."
            | "cbrr:Parcel 1 starts with the condition; `Ra` and `Rb` are compared."
            | "sob:The displacement is signed and counts parcels."
            | "tag:`sense` is 0 for `BTAG` and 1 for `BNTAG`; `tag` is the 3-bit tag."
            | "sop:The `reg` field is the sub-opcode; the operand is `rm` with its mode, at any length."
            | "xfer:The `reg` field is the sub-opcode; the operand is `rm` with its mode, at any length."
            | "besc:From `len = 01`. In this group `low` is a register, never a mode."
            | "aesc:From `len = 01`. In this group `low` is a register, never a mode."
            | "fesc:From `len = 01`. In this group `low` is a register, never a mode."
            | "atom:From `len = 01`. The placement of the operands is not specified."
            | "mblk:`reg` is the destination pointer, `low` the source pointer (or the value register), `Rn` the count register."
            | "mesc:`low` of parcel 0 is an addressing mode; parcel 1 holds the sub-opcode, `rm` and the first 8 bits of the displacement."
            | "sysn:The `reg` field is the class (0); class 0 takes a minor opcode from `low`."
            | "sysx:Class 0, minor 15: the sub-opcode is in parcel 1."
            | "sysreg:Class 0: the system register number is in parcel 1."
            | "sys:The `reg` field is the class; the other classes take a register or a 4-bit immediate from `low`."
