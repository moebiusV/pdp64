; the pdp64: the grammar of the encoding -- 32 registers (r0-r31), 181 forms, 239 leaves.
;
; Written by docs/codegen-data/encoding/write_hbnf.py and edited by hand from then on (the vocabulary is in pdp64-enc.hbnf, the workflow in spec/README.md).
; Everything the codec, the assembler, the linker, the simulator and the documentation know of this encoding is generated from this file.

prefix none
include "../pdp64-enc.hbnf"

; The instruction: one leaf.  A first parcel that no leaf matches (911 of the 65,536) is an illegal instruction.
insn = leaf:( leaf-SYS0-1 | leaf-SYS0-2 | leaf-SYSR-1 | leaf-SYSR-2 | leaf-CT1-1 | leaf-SETF-1 | leaf-SYSI-1 | leaf-MFSR-1 | leaf-MTSR-1 | leaf-R2-1
       | leaf-R3-1 | leaf-R4-1 | leaf-RRI-1 | leaf-BFx-1 | leaf-BFy-1 | leaf-MOVQL-1 | leaf-LDU-B28-1 | leaf-LDU-B28-2 | leaf-LDU-B28-3
       | leaf-STU-B28-1 | leaf-LDU-B12-1 | leaf-LDU-B12-2 | leaf-LDU-B12-3 | leaf-STU-B12-1 | leaf-LDU-X6-1 | leaf-LDU-X6-2 | leaf-LDU-X6-3
       | leaf-STU-X6-1 | leaf-LDF-B28-1 | leaf-LDF-B28-2 | leaf-LDF-B28-3 | leaf-LDF-B28-4 | leaf-LDF-X22-1 | leaf-LDF-X22-2 | leaf-LDF-X22-3
       | leaf-LDF-X22-4 | leaf-LDF-PI12-1 | leaf-LDF-PI12-2 | leaf-LDF-PI12-3 | leaf-LDF-PI12-4 | leaf-LDF-PD12-1 | leaf-LDF-PD12-2 | leaf-LDF-PD12-3
       | leaf-LDF-PD12-4 | leaf-LDF-PC32-1 | leaf-LDF-PC32-2 | leaf-LDF-PC32-3 | leaf-LDF-PC32-4 | leaf-LDF-A32-1 | leaf-LDF-A32-2 | leaf-LDF-A32-3
       | leaf-LDF-A32-4 | leaf-LDFI-I32-1 | leaf-LDFI-I32-2 | leaf-LDFI-I32-3 | leaf-STF-B28-1 | leaf-STF-B28-2 | leaf-STF-X22-1 | leaf-STF-X22-2
       | leaf-STF-PI12-1 | leaf-STF-PI12-2 | leaf-STF-PD12-1 | leaf-STF-PD12-2 | leaf-STF-PC32-1 | leaf-STF-PC32-2 | leaf-STF-A32-1 | leaf-STF-A32-2
       | leaf-CMF-B28-1 | leaf-CMF-X22-1 | leaf-CMF-PI12-1 | leaf-CMF-PD12-1 | leaf-CMF-PC32-1 | leaf-CMF-A32-1 | leaf-CMF-I32-1 | leaf-SOF-B28-1
       | leaf-SOF-X22-1 | leaf-SOF-PI12-1 | leaf-SOF-PD12-1 | leaf-SOF-PC32-1 | leaf-SOF-A32-1 | leaf-DPF-D28-1 | leaf-DPF-D28-2 | leaf-DPF-D28-3
       | leaf-DPF-D28-4 | leaf-BRF-1 | leaf-BRF-2 | leaf-BRF-3 | leaf-BRF-4 | leaf-CALLF-1 | leaf-PUSHMF-1 | leaf-SOPR-1 | leaf-SOPR-2 | leaf-SOPR-3
       | leaf-PUSHI3-1 | leaf-PUSHI2-1 | leaf-JTAG3-1 | leaf-JTAG2-1 | leaf-RRF-1 | leaf-RRF-2 | leaf-RRF5-1 | leaf-CBDI-1 | leaf-CBDR-1 | leaf-SOB-1
       | leaf-TAG-1 | leaf-SPADJF-1 | leaf-FX-MOVCALL3-1 | leaf-FX-MOVCALL2-1 | leaf-FX-POPMRET-1 | leaf-FX-POPRET-1 | leaf-FX-MOV2-1 | leaf-RR5-1
       | leaf-BR1-6-c-1 | leaf-BR1-6-c-2 | leaf-BR1-7-b-1 | leaf-BR1-9-a-1 | leaf-STHHH1-b-1 | leaf-LDHHH3-a-1 | leaf-STHHH3-a-1 | leaf-STSPh4-a-1
       | leaf-LDSPh5-a-1 | leaf-LEASPh5-a-1 | leaf-IMMh44-b-1 | leaf-IMMh44-b-2 | leaf-SHIh44-a-1 | leaf-IMMh47-a-1 | leaf-SPADJ6-a-1
       | leaf-PUSHM8-a-1 | leaf-PUSHM24-a-1 | leaf-CBZ1-5-a-1 | leaf-LDBs6-b-1 | leaf-STBs6-b-1 | leaf-LDBu6-b-1 | leaf-STBs8-a-1 | leaf-LDBu8-c-1
       | leaf-LDBu8-c-2 | leaf-CMBu8-a-1 | leaf-LDBs10-a-1 | leaf-SOBs12-a-1 | leaf-SOBs12-a-2 | leaf-SOBu12-x-1 | leaf-LDX0-a-1 | leaf-LDX0-b-1
       | leaf-LDX0-c-1 | leaf-LDX0-c-2 | leaf-STX0-a-1 | leaf-STX0-b-1 | leaf-CMX0-a-1 | leaf-SOX4-a-1 | leaf-SOX4-a-2 | leaf-SOX4-x-1
       | leaf-LDPC14-a-1 | leaf-LDI12-a-1 | leaf-LDI12-b-1 | leaf-LDI12-b-2 | leaf-LDI12-d-1 | leaf-LDI12-d-2 | leaf-LDI12-d-3 | leaf-CMI12-a-1
       | leaf-CTM12-a-1 | leaf-BR2-16-a-1 | leaf-BR2-16-b-1 | leaf-BR2-16-c-1 | leaf-BR2-16-c-2 | leaf-CALL2-16-j-1 | leaf-CALL2-20-c-1
       | leaf-CBR8-a-1 | leaf-CBR8-b-1 | leaf-CBR8-c-1 | leaf-CB3I12-16-b-1 | leaf-CB3I16-12-a-1 | leaf-CB3I16-12-c-1 | leaf-CB3R24-a-1
       | leaf-CBI3-10-a-1 | leaf-CBI4-8-b-1 | leaf-CBI5-8-a-1 | leaf-STBs8H-b-1 | leaf-LDBu10H-c-1 | leaf-LDBu10H-c-2 | leaf-LDBu12H-a-1
       | leaf-LDBu12H-b-1 | leaf-STBu12H-a-1 | leaf-STBu12H-b-1 | leaf-CMBu12H-a-1 | leaf-SOBu12H-a-1 | leaf-SOBu12H-a-2 | leaf-LEAS12H-a-1
       | leaf-LDX4H-b-1 | leaf-LDX6H-a-1 | leaf-STX6H-a-1 | leaf-STX6H-b-1 | leaf-LDPC12H-d-1 | leaf-LDPC12H-d-2 | leaf-LDPC14H-b-1 | leaf-LDPC16H-a-1
       | leaf-LDPC16H-c-1 | leaf-LDPC16H-c-2 | leaf-CMPC16H-a-1 | leaf-LDI14H-c-1 | leaf-LDI18H-a-1 | leaf-LDI18H-b-1 | leaf-LDI18H-b-2
       | leaf-CMI18H-a-1 | leaf-CBR10H-a-1 | leaf-CBR10H-c-1 | leaf-CBZ2-12H-b-1 | leaf-CBZ2-14H-a-1 | leaf-CB3I12-16H-a-1 | leaf-CB3I16-12H-b-1
       | leaf-CB3R24H-b-1 | leaf-CBI3-10H-b-1 | leaf-CBI3-10H-c-1 | leaf-CBI3-12H-a-1 | leaf-CBI8-8H-b-1 | leaf-CBI8-8H-c-1 | leaf-CBI8-10H-a-1
       | leaf-CBI10-8H-a-1 | leaf-VBEG-1 | leaf-VEND-1 | leaf-VFIN-1 | leaf-VOP-VVV-1 | leaf-VOP-VVR-1 | leaf-VOP-VVI-1 | leaf-VDACC-1 | leaf-VTBLM-1
       | leaf-VOP-VV-1 | leaf-VBSL-1 | leaf-VOP-VR-1 | leaf-VOP-VI-1 | leaf-VFMAB-1 | leaf-VACC-1 | leaf-VFIR-1 | leaf-VCLR-1 | leaf-VLD-PI-1
       | leaf-VLD-B-1 | leaf-VST-PI-1 | leaf-VST-B-1 | leaf-VLDT-1 | leaf-VSTT-1 | leaf-VSTS-R-1 )

encoding-name = "pdp64"

; ---- the registers
regs = "r0"@0 | "r1"@1 | "r2"@2 | "r3"@3 | "r4"@4 | "r5"@5 | "r6"@6 | "r7"@7 | "r8"@8 | "r9"@9 | "r10"@10 | "r11"@11 | "r12"@12 | "r13"@13 | "r14"@14
     | "r15"@15 | "r16"@16 | "r17"@17 | "r18"@18 | "r19"@19 | "r20"@20 | "r21"@21 | "r22"@22 | "r23"@23 | "r24"@24 | "r25"@25 | "r26"@26 | "r27"@27
     | "r28"@28 | "r29"@29 | "r30"@30 | "r31"@31
; A register field of W bits that cannot hold a register number is an index into the table hotW (the part of the ABI the encoding depends on, docs/abi.md).
hot3 = "r0" | "r1" | "r8" | "r2" | "sp" | "r3" | "r9" | "r10"
hot4 = "r0" | "r1" | "r8" | "r2" | "sp" | "r3" | "r9" | "r10" | "r11" | "r4" | "r15" | "r5" | "r24" | "r25" | "r26" | "r6"

; ---- the fused instructions (the assembler never fuses: they are ordinary mnemonics with operands, chosen by the compiler)
fused = "movcall" | "popmret" | "popret" | "mov2"

; ---- the catalogue of forms: the number is the index of the form (the assembler tries the forms of a mnemonic, shorter first, in this order)
forms = "SYS0"@0 | "SYSR"@1 | "CT1"@2 | "SETF"@3 | "SYSI"@4 | "MFSR"@5 | "MTSR"@6 | "R2"@7 | "R3"@8 | "R4"@9 | "RRI"@10 | "BFx"@11 | "BFy"@12
      | "MOVQL"@13 | "LDU.B28"@14 | "STU.B28"@15 | "LDU.B12"@16 | "STU.B12"@17 | "LDU.X6"@18 | "STU.X6"@19 | "LDF.B28"@20 | "LDF.X22"@21
      | "LDF.PI12"@22 | "LDF.PD12"@23 | "LDF.PC32"@24 | "LDF.A32"@25 | "LDFI.I32"@26 | "STF.B28"@27 | "STF.X22"@28 | "STF.PI12"@29 | "STF.PD12"@30
      | "STF.PC32"@31 | "STF.A32"@32 | "CMF.B28"@33 | "CMF.X22"@34 | "CMF.PI12"@35 | "CMF.PD12"@36 | "CMF.PC32"@37 | "CMF.A32"@38 | "CMF.I32"@39
      | "SOF.B28"@40 | "SOF.X22"@41 | "SOF.PI12"@42 | "SOF.PD12"@43 | "SOF.PC32"@44 | "SOF.A32"@45 | "DPF.D28"@46 | "BRF"@47 | "CALLF"@48
      | "PUSHMF"@49 | "SOPR"@50 | "PUSHI3"@51 | "PUSHI2"@52 | "JTAG3"@53 | "JTAG2"@54 | "RRF"@55 | "RRF5"@56 | "CBDI"@57 | "CBDR"@58 | "SOB"@59
      | "TAG"@60 | "SPADJF"@61 | "FX.MOVCALL3"@62 | "FX.MOVCALL2"@63 | "FX.POPMRET"@64 | "FX.POPRET"@65 | "FX.MOV2"@66 | "RR5"@67 | "BR1_6/c"@68
      | "BR1_7/b"@69 | "BR1_9/a"@70 | "STHHH1/b"@71 | "LDHHH3/a"@72 | "STHHH3/a"@73 | "STSPh4/a"@74 | "LDSPh5/a"@75 | "LEASPh5/a"@76 | "IMMh44/b"@77
      | "SHIh44/a"@78 | "IMMh47/a"@79 | "SPADJ6/a"@80 | "PUSHM8/a"@81 | "PUSHM24/a"@82 | "CBZ1_5/a"@83 | "LDBs6/b"@84 | "STBs6/b"@85 | "LDBu6/b"@86
      | "STBs8/a"@87 | "LDBu8/c"@88 | "CMBu8/a"@89 | "LDBs10/a"@90 | "SOBs12/a"@91 | "SOBu12/x"@92 | "LDX0/a"@93 | "LDX0/b"@94 | "LDX0/c"@95
      | "STX0/a"@96 | "STX0/b"@97 | "CMX0/a"@98 | "SOX4/a"@99 | "SOX4/x"@100 | "LDPC14/a"@101 | "LDI12/a"@102 | "LDI12/b"@103 | "LDI12/d"@104
      | "CMI12/a"@105 | "CTM12/a"@106 | "BR2_16/a"@107 | "BR2_16/b"@108 | "BR2_16/c"@109 | "CALL2_16/j"@110 | "CALL2_20/c"@111 | "CBR8/a"@112
      | "CBR8/b"@113 | "CBR8/c"@114 | "CB3I12_16/b"@115 | "CB3I16_12/a"@116 | "CB3I16_12/c"@117 | "CB3R24/a"@118 | "CBI3_10/a"@119 | "CBI4_8/b"@120
      | "CBI5_8/a"@121 | "STBs8H/b"@122 | "LDBu10H/c"@123 | "LDBu12H/a"@124 | "LDBu12H/b"@125 | "STBu12H/a"@126 | "STBu12H/b"@127 | "CMBu12H/a"@128
      | "SOBu12H/a"@129 | "LEAS12H/a"@130 | "LDX4H/b"@131 | "LDX6H/a"@132 | "STX6H/a"@133 | "STX6H/b"@134 | "LDPC12H/d"@135 | "LDPC14H/b"@136
      | "LDPC16H/a"@137 | "LDPC16H/c"@138 | "CMPC16H/a"@139 | "LDI14H/c"@140 | "LDI18H/a"@141 | "LDI18H/b"@142 | "CMI18H/a"@143 | "CBR10H/a"@144
      | "CBR10H/c"@145 | "CBZ2_12H/b"@146 | "CBZ2_14H/a"@147 | "CB3I12_16H/a"@148 | "CB3I16_12H/b"@149 | "CB3R24H/b"@150 | "CBI3_10H/b"@151
      | "CBI3_10H/c"@152 | "CBI3_12H/a"@153 | "CBI8_8H/b"@154 | "CBI8_8H/c"@155 | "CBI8_10H/a"@156 | "CBI10_8H/a"@157 | "VBEG"@158 | "VEND"@159
      | "VFIN"@160 | "VOP.VVV"@161 | "VOP.VVR"@162 | "VOP.VVI"@163 | "VDACC"@164 | "VTBLM"@165 | "VOP.VV"@166 | "VBSL"@167 | "VOP.VR"@168
      | "VOP.VI"@169 | "VFMAB"@170 | "VACC"@171 | "VFIR"@172 | "VCLR"@173 | "VLD.PI"@174 | "VLD.B"@175 | "VST.PI"@176 | "VST.B"@177 | "VLDT"@178
      | "VSTT"@179 | "VSTS.R"@180

; ======================================================================================================================================================
; family SYS: 1 form, 2 leaves, 1 parcel; mnemonics nop rti rtt ret halt bpt ...
; ======================================================================================================================================================

; form SYS0 (index 0): 1 parcel
form-SYS0 = noop
leaf-SYS0-1 = 0b11110111110 sub:5
sub-SYS0-1 = "nop" | "rti" | "rtt" | "ret" | "halt" | "bpt" | "fence" | "wfe" | "sev" | "lpad" | "tlbia" | "tlbsync" | "icinva" | "pushx" | "popx"
     | "isync" | "trapcc.ne" | "trapcc.eq" | "trapcc.pl" | "trapcc.mi" | "trapcc.vc" | "trapcc.vs" | "trapcc.cc" | "trapcc.cs" | "trapcc.ge"
     | "trapcc.lt" | "trapcc.gt" | "trapcc.le" | "trapcc.hi" | "trapcc.los" | "syspg0" | "syspg1"
leaf-SYS0-2 = 0b11111011101110 sub:2
sub-SYS0-2 = "syspg2" | "syspg3" | "syspg4" | "syspg5"

; ======================================================================================================================================================
; family SYSR: 1 form, 2 leaves, 1 parcel; mnemonics mtps mfps tlbi mtasid mfasid mtdp ...
; ======================================================================================================================================================

; form SYSR (index 1): 1 parcel
form-SYSR = o1:reg5
leaf-SYSR-1 = 0b11010000 sub:3 o1-r:5
sub-SYSR-1 = "mtps" | "mfps" | "tlbi" | "mtasid" | "mfasid" | "mtdp" | "mfdp" | "mtdmw"
leaf-SYSR-2 = 0b1111000100 sub:1 o1-r:5
sub-SYSR-2 = "mfcpuid" | "icinv"

; ======================================================================================================================================================
; family CT: 1 form, 1 leaves, 1 parcel; mnemonics cteq ctne
; ======================================================================================================================================================

; form CT1 (index 2): 1 parcel
form-CT1 = o1:reg5
leaf-CT1-1 = 0b1111000101 sub:1 o1-r:5
sub-CT1-1 = "cteq" | "ctne"

; ======================================================================================================================================================
; family SETF: 1 form, 1 leaves, 2 parcels; mnemonics set
; ======================================================================================================================================================

; form SETF (index 3): 2 parcels
form-SETF = o1:imm4u o2:reg5
leaf-SETF-1 = 0b11110111111 o2-r:5 o1-imm:4 xsub:12 ?(xsub < 1)
sub-SETF-1 = "set"

; ======================================================================================================================================================
; family SYSI: 1 form, 1 leaves, 1 parcel; mnemonics spl trap trapl hint
; ======================================================================================================================================================

; form SYSI (index 4): 1 parcel
form-SYSI = o1:imm8u
leaf-SYSI-1 = 0b011110 sub:2 o1-imm:8
sub-SYSI-1 = "spl" | "trap" | "trapl" | "hint"

; ======================================================================================================================================================
; family MFSR: 1 form, 1 leaves, 2 parcels; mnemonics mfsr
; ======================================================================================================================================================

; form MFSR (index 5): 2 parcels
form-MFSR = o1:reg5 o2:imm12u
leaf-MFSR-1 = 0b111111000001000 o1-r:5 o2-imm:12
sub-MFSR-1 = "mfsr"

; ======================================================================================================================================================
; family MTSR: 1 form, 1 leaves, 2 parcels; mnemonics mtsr
; ======================================================================================================================================================

; form MTSR (index 6): 2 parcels
form-MTSR = o1:imm12u o2:reg5
leaf-MTSR-1 = 0b111111000001001 o2-r:5 o1-imm:12
sub-MTSR-1 = "mtsr"

; ======================================================================================================================================================
; family R: 3 forms, 3 leaves, 2 parcels; mnemonics clz ctz clo cto popcnt bswap ...
; ======================================================================================================================================================

; form R2 (index 7): 2 parcels
form-R2 = o1:reg5 o2:reg5
leaf-R2-1 = 0b111110011110 o1-r:5 o2-r:5 xsub:10 ?(xsub < 81)
sub-R2-1 = "clz" | "ctz" | "clo" | "cto" | "popcnt" | "bswap" | "bswapw" | "bswapl" | "bitrev" | "utf8len" | "utf8dec" | "utf8enc" | "ctcc" | "ctcs"
     | "cthi" | "ctlos" | "cteq" | "ctne" | "ctge" | "ctlt" | "ctgt" | "ctle" | "ctpl" | "ctmi" | "ctvc" | "ctvs" | "mval" | "abs" | "prober"
     | "probew" | "fdiv" | "fsqrt" | "fadd32" | "fsub32" | "fmul32" | "fdiv32" | "fsqrt32" | "fcmp32" | "fneg" | "fabs" | "fclass" | "fclass32"
     | "frint" | "frintz" | "frintm" | "frintp" | "frinta" | "fcvtdq" | "fcvtqd" | "fcvtds" | "fcvtsd" | "fcvtsl" | "fcvtls" | "fcvtdqu" | "fcvtqud"
     | "fsflags" | "fadd16" | "fsub16" | "fmul16" | "fdiv16" | "fsqrt16" | "fcmp16" | "fclass16" | "fcvtsh" | "fcvths" | "fcvtdh" | "fcvthd"
     | "fcvthl" | "fcvtlh" | "aesim" | "sha256sig0" | "sha256sig1" | "sha256sum0" | "sha256sum1" | "sha512sig0" | "sha512sig1" | "sha512sum0"
     | "sha512sum1" | "addv" | "subv" | "mulv"

; form R3 (index 8): 2 parcels
form-R3 = o1:reg5 o2:reg5 o3:reg5
leaf-R3-1 = 0b1111000110 xsub-1:1 o3-r:5 xsub-2:6 o1-r:5 o2-r:5 ?(((xsub_1 << 6) | xsub_2) < 52)
sub-R3-1 = "chk2" | "ror" | "xnorpop" | "clmull" | "clmulh" | "mcpy" | "mmov" | "mset" | "mcmp" | "mscn" | "mscnn" | "div" | "divu" | "mod" | "modu"
     | "mulhu" | "min" | "minu" | "max" | "maxu" | "fcopysign" | "fmin" | "fmax" | "maskeqz" | "masknez" | "aeses" | "aesesm" | "aesds" | "aesdsm"
     | "aesks2" | "xadd" | "xadddb" | "swap" | "swapdb" | "xand" | "xanddb" | "xor_" | "xor_db" | "xxor" | "xxordb" | "xmax" | "xmaxdb" | "xmin"
     | "xmindb" | "xmaxu" | "xmaxudb" | "xminu" | "xminudb" | "ll" | "sc" | "msha256" | "msha512"

; form R4 (index 9): 2 parcels
form-R4 = o1:reg5 o2:reg5 o3:reg5 o4:reg5
leaf-R4-1 = 0b11010001 xsub-1:3 o4-r:5 xsub-2:1 o1-r:5 o2-r:5 o3-r:5
sub-R4-1 = "fmadd" | "fmsub" | "fnmadd" | "fnmsub" | "fmadd32" | "fmsub32" | "fnmadd32" | "fnmsub32" | "fmadd16" | "fmsub16" | "fnmadd16" | "fnmsub16"
     | "bsel" | "cas" | "casdb" | "maesctr"

; ======================================================================================================================================================
; family RRI: 1 form, 1 leaves, 2 parcels; mnemonics rori rori32 rol aesks1
; ======================================================================================================================================================

; form RRI (index 10): 2 parcels
form-RRI = o1:reg5 o2:imm6u o3:reg5
leaf-RRI-1 = 0b111110011111 xsub:4 o1-r:5 o2-imm:6 o3-r:5 ?(xsub < 4)
sub-RRI-1 = "rori" | "rori32" | "rol" | "aesks1"

; ======================================================================================================================================================
; family BFx: 1 form, 1 leaves, 3 parcels; mnemonics dshr
; ======================================================================================================================================================

; form BFx (index 11): 3 parcels
form-BFx = o1:reg5 o2:reg5 o3:imm6u o4:reg5
leaf-BFx-1 = 0b1010100 o1-r-1:4 o4-r:5 o1-r-2:1 o2-r:5 o3-imm:6 xsub:20 ?(xsub < 1)
sub-BFx-1 = "dshr"

; ======================================================================================================================================================
; family BFy: 1 form, 1 leaves, 3 parcels; mnemonics extb extzb insb
; ======================================================================================================================================================

; form BFy (index 12): 3 parcels
form-BFy = o1:reg5 o2:imm6u o3:imm6u o4:reg5
leaf-BFy-1 = 0b11010010 o1-r-1:3 o4-r:5 o1-r-2:2 o2-imm:6 o3-imm:6 xsub:18 ?(xsub < 3)
sub-BFy-1 = "extb" | "extzb" | "insb"

; ======================================================================================================================================================
; family MOVQL: 1 form, 1 leaves, 5 parcels; mnemonics movql
; ======================================================================================================================================================

; form MOVQL (index 13): 5 parcels
form-MOVQL = o1:imm64s o2:reg5
leaf-MOVQL-1 = 0b11111000000 o2-r:5 o1-imm:64
sub-MOVQL-1 = "movql"

; ======================================================================================================================================================
; family LDU.B: 2 forms, 6 leaves, 3 parcels; mnemonics movq.u movl.u movw.u movb.u movzl.u movzw.u ...
; ======================================================================================================================================================

; form LDU.B28 (index 14): 3 parcels
form-LDU-B28 = o1:b5d28s-x1 o2:reg5
leaf-LDU-B28-1 = 0b011111 sub:4 o1-base-1:1 o2-r:5 o1-base-2:4 o1-d:28
sub-LDU-B28-1 = "movq.u" | "movl.u" | "movw.u" | "movb.u" | "movzl.u" | "movzw.u" | "movzb.u" | "movq.d" | "movl.d" | "movw.d" | "movb.d" | "movzl.d"
