; ======================================================================================================================================================
; family SYS: 1 form, 2 leaves, 1 parcel; mnemonics nop rti rtt ret halt bpt ...
; ======================================================================================================================================================

; form SYS0 (index 0): 1 parcel
form-SYS0 = noop
leaf-SYS0-1 = 0b11101110010 sub:5
sub-SYS0-1 = "nop" | "rti" | "rtt" | "ret" | "halt" | "bpt" | "fence" | "wfe" | "sev" | "lpad" | "tlbia" | "tlbsync" | "icinva" | "pushx" | "popx"
     | "isync" | "trapcc.ne" | "trapcc.eq" | "trapcc.pl" | "trapcc.mi" | "trapcc.vc" | "trapcc.vs" | "trapcc.cc" | "trapcc.cs" | "trapcc.ge"
     | "trapcc.lt" | "trapcc.gt" | "trapcc.le" | "trapcc.hi" | "trapcc.los" | "syspg0" | "syspg1"
leaf-SYS0-2 = 0b11110010001100 sub:2
sub-SYS0-2 = "syspg2" | "syspg3" | "syspg4" | "syspg5"

; ======================================================================================================================================================
; family SYSR: 1 form, 2 leaves, 1 parcel; mnemonics mtps mfps tlbi mtasid mfasid mtdp ...
; ======================================================================================================================================================

; form SYSR (index 1): 1 parcel
form-SYSR = o1:reg5
leaf-SYSR-1 = 0b11000100 sub:3 o1-r:5
sub-SYSR-1 = "mtps" | "mfps" | "tlbi" | "mtasid" | "mfasid" | "mtdp" | "mfdp" | "mtdmw"
leaf-SYSR-2 = 0b1110100000 sub:1 o1-r:5
sub-SYSR-2 = "mfcpuid" | "icinv"

; ======================================================================================================================================================
; family SETF: 1 form, 1 leaves, 2 parcels; mnemonics set
; ======================================================================================================================================================

; form SETF (index 2): 2 parcels
form-SETF = o1:imm4u o2:reg5
leaf-SETF-1 = 0b11101110011 o2-r:5 o1-imm:4 xsub:12 ?(xsub < 1)
sub-SETF-1 = "set"

; ======================================================================================================================================================
; family SYSI: 1 form, 1 leaves, 1 parcel; mnemonics spl trap trapl hint
; ======================================================================================================================================================

; form SYSI (index 3): 1 parcel
form-SYSI = o1:imm8u
leaf-SYSI-1 = 0b011010 sub:2 o1-imm:8
sub-SYSI-1 = "spl" | "trap" | "trapl" | "hint"

; ======================================================================================================================================================
; family MFSR: 1 form, 1 leaves, 2 parcels; mnemonics mfsr
; ======================================================================================================================================================

; form MFSR (index 4): 2 parcels
form-MFSR = o1:reg5 o2:imm12u
leaf-MFSR-1 = 0b111100101110000 o1-r:5 o2-imm:12
sub-MFSR-1 = "mfsr"

; ======================================================================================================================================================
; family MTSR: 1 form, 1 leaves, 2 parcels; mnemonics mtsr
; ======================================================================================================================================================

; form MTSR (index 5): 2 parcels
form-MTSR = o1:imm12u o2:reg5
leaf-MTSR-1 = 0b111100101110001 o2-r:5 o1-imm:12
sub-MTSR-1 = "mtsr"

; ======================================================================================================================================================
; family R: 3 forms, 3 leaves, 2 parcels; mnemonics clz ctz clo cto popcnt bswap ...
; ======================================================================================================================================================

; form R2 (index 6): 2 parcels
form-R2 = o1:reg5 o2:reg5
leaf-R2-1 = 0b111100000010 o1-r:5 o2-r:5 xsub:10 ?(xsub < 67)
sub-R2-1 = "clz" | "ctz" | "clo" | "cto" | "popcnt" | "bswap" | "bswapw" | "bswapl" | "bitrev" | "utf8len" | "utf8dec" | "utf8enc" | "mval" | "abs"
     | "prober" | "probew" | "fdiv" | "fsqrt" | "fadd32" | "fsub32" | "fmul32" | "fdiv32" | "fsqrt32" | "fcmp32" | "fneg" | "fabs" | "fclass"
     | "fclass32" | "frint" | "frintz" | "frintm" | "frintp" | "frinta" | "fcvtdq" | "fcvtqd" | "fcvtds" | "fcvtsd" | "fcvtsl" | "fcvtls" | "fcvtdqu"
     | "fcvtqud" | "fsflags" | "fadd16" | "fsub16" | "fmul16" | "fdiv16" | "fsqrt16" | "fcmp16" | "fclass16" | "fcvtsh" | "fcvths" | "fcvtdh"
     | "fcvthd" | "fcvthl" | "fcvtlh" | "aesim" | "sha256sig0" | "sha256sig1" | "sha256sum0" | "sha256sum1" | "sha512sig0" | "sha512sig1"
     | "sha512sum0" | "sha512sum1" | "addv" | "subv" | "mulv"

; form R3 (index 7): 2 parcels
form-R3 = o1:reg5 o2:reg5 o3:reg5
leaf-R3-1 = 0b1110100001 xsub-1:1 o3-r:5 xsub-2:6 o1-r:5 o2-r:5 ?(((xsub_1 << 6) | xsub_2) < 51)
sub-R3-1 = "ror" | "xnorpop" | "clmull" | "clmulh" | "mcpy" | "mmov" | "mset" | "mcmp" | "mscn" | "mscnn" | "div" | "divu" | "mod" | "modu" | "mulhu"
     | "min" | "minu" | "max" | "maxu" | "fcopysign" | "fmin" | "fmax" | "maskeqz" | "masknez" | "aeses" | "aesesm" | "aesds" | "aesdsm" | "aesks2"
     | "xadd" | "xadddb" | "swap" | "swapdb" | "xand" | "xanddb" | "xor_" | "xor_db" | "xxor" | "xxordb" | "xmax" | "xmaxdb" | "xmin" | "xmindb"
     | "xmaxu" | "xmaxudb" | "xminu" | "xminudb" | "ll" | "sc" | "msha256" | "msha512"

; form R4 (index 8): 2 parcels
form-R4 = o1:reg5 o2:reg5 o3:reg5 o4:reg5
leaf-R4-1 = 0b11000101 xsub-1:3 o4-r:5 xsub-2:1 o1-r:5 o2-r:5 o3-r:5
sub-R4-1 = "fmadd" | "fmsub" | "fnmadd" | "fnmsub" | "fmadd32" | "fmsub32" | "fnmadd32" | "fnmsub32" | "fmadd16" | "fmsub16" | "fnmadd16" | "fnmsub16"
     | "bsel" | "cas" | "casdb" | "maesctr"

; ======================================================================================================================================================
; family RRI: 1 form, 1 leaves, 2 parcels; mnemonics rori rori32 rol aesks1
; ======================================================================================================================================================

; form RRI (index 9): 2 parcels
form-RRI = o1:reg5 o2:imm6u o3:reg5
leaf-RRI-1 = 0b111100000011 xsub:4 o1-r:5 o2-imm:6 o3-r:5 ?(xsub < 4)
sub-RRI-1 = "rori" | "rori32" | "rol" | "aesks1"

; ======================================================================================================================================================
; family BFx: 1 form, 1 leaves, 3 parcels; mnemonics dshr
; ======================================================================================================================================================

