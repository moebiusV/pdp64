diff --git a/llvm/include/llvm/BinaryFormat/ELFRelocs/PDP64.def b/llvm/include/llvm/BinaryFormat/ELFRelocs/PDP64.def
new file mode 100644
index 000000000..0ffb3846d
--- /dev/null
+++ b/llvm/include/llvm/BinaryFormat/ELFRelocs/PDP64.def
@@ -0,0 +1,12 @@
+#ifndef ELF_RELOC
+#error "ELF_RELOC must be defined"
+#endif
+
+// pdp64 relocations (as64/relocs.h in github.com/moebiusV/pdp64).  "INSN" ones patch the last 16*len bits of an
+// instruction whose first parcel is at r_offset.
+ELF_RELOC(R_PDP64_NONE,     0)
+ELF_RELOC(R_PDP64_D64,      1) // 64-bit data: S + A
+ELF_RELOC(R_PDP64_D32,      2) // 32-bit data: S + A
+ELF_RELOC(R_PDP64_INSN_ABS, 3) // immediate or absolute operand: S + A, signed
+ELF_RELOC(R_PDP64_INSN_PC,  4) // d(PC) operand: S + A - P, in bytes
+ELF_RELOC(R_PDP64_INSN_BR,  5) // branch: (S + A - P) / 2, in parcels
